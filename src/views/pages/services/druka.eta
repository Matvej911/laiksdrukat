<% layout('../../partials/layout', { bodyClass: 'page-druka' }) %>

<!-- HERO -->
<section class="dr-hero">
  <div class="container">
    <%~ include('../../partials/breadcrumbs', { breadcrumbs: it.breadcrumbs }) %>
    <div class="dr-hero-inner">
      <div class="dr-hero-copy">
        <span class="dr-eyebrow">Pakalpojums</span>
        <h1>Reklāmas un poligrāfijas drukas pakalpojumi</h1>
        <p>Piedāvājam dažādu drukas produktu izgatavošanu uzņēmumiem, pasākumiem un reklāmai. No vienkāršiem flajeriem līdz pilnvērtīgām brošūrām un kalendāriem.</p>
        <div class="dr-hero-actions">
          <a href="#dr-contact" class="dr-btn-primary">Saņemt piedāvājumu</a>
          <a href="#dr-types" class="dr-btn-outline">Skatīt produktus</a>
        </div>
        <div class="dr-hero-tags">
          <span>Bukleti</span>
          <span>Brošūras</span>
          <span>Flajeri</span>
          <span>Plakāti</span>
          <span>Kalendāri</span>
        </div>
      </div>
      <div class="dr-hero-visual">
        <div class="dr-mockup-grid">
          <div class="dr-mockup dr-mockup-1">
            <div class="dr-mockup-inner">
              <div class="dr-mock-wave"></div>
              <span class="dr-mock-title">Brošūras</span>
              <span class="dr-mock-sub">A4 / A5</span>
            </div>
          </div>
          <div class="dr-mockup dr-mockup-2">
            <div class="dr-mockup-inner dr-mockup-dark">
              <span class="dr-mock-title">Flajeri</span>
              <div class="dr-mock-lines">
                <span></span><span></span><span></span>
              </div>
            </div>
          </div>
          <div class="dr-mockup dr-mockup-3">
            <div class="dr-mockup-inner dr-mockup-yellow">
              <span class="dr-mock-title">Plakāti</span>
              <span class="dr-mock-sub">A2 / A1</span>
            </div>
          </div>
          <div class="dr-mockup dr-mockup-4">
            <div class="dr-mockup-inner">
              <div class="dr-mock-calendar">
                <span>Marts</span>
                <div class="dr-cal-grid">
                  <span>P</span><span>O</span><span>T</span><span>C</span><span>P</span><span>S</span><span>Sv</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PRODUCT TYPES -->
<section class="dr-types" id="dr-types">
  <div class="container">
    <div class="dr-section-header">
      <span class="dr-eyebrow-dark">Ko piedāvājam</span>
      <h2>Drukas produkti</h2>
      <p>Izgatavojam visu veidu poligrāfijas un reklāmas drukas materiālus.</p>
    </div>

    <div class="dr-types-list">
      <div class="dr-type-card">
        <div class="dr-type-icon">
          <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        </div>
        <h4>Bukleti</h4>
        <p>Dažādi formāti un locījumi — ideāli uzņēmuma prezentācijai.</p>
      </div>
      <div class="dr-type-card">
        <div class="dr-type-icon">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
        </div>
        <h4>Brošūras</h4>
        <p>Vairāku lapu drukas materiāli katalogiem un informācijai.</p>
      </div>
      <div class="dr-type-card">
        <div class="dr-type-icon">
          <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/></svg>
        </div>
        <h4>Flajeri / Skrejlapas</h4>
        <p>Reklāmas un informatīvie materiāli akcijām un kampaņām.</p>
      </div>
      <div class="dr-type-card">
        <div class="dr-type-icon">
          <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
        </div>
        <h4>Plakāti un afišas</h4>
        <p>Dažādi izmēri un papīra veidi vizuālai komunikācijai.</p>
      </div>
      <div class="dr-type-card">
        <div class="dr-type-icon">
          <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <h4>Kalendāri</h4>
        <p>Sienas un galda kalendāri ar jūsu zīmolu un dizainu.</p>
      </div>
      <div class="dr-type-card">
        <div class="dr-type-icon">
          <svg viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
        </div>
        <h4>Etiķetes un birkas</h4>
        <p>No idejas līdz gatavam produktam — birkas, etiķetes un cenu zīmes.</p>
      </div>
    </div>
  </div>
</section>

<!-- PRODUCTS SHOWCASE -->
<section class="dr-showcase">
  <div class="container">
    <div class="dr-section-header center">
      <span class="dr-eyebrow-dark">Piemēri</span>
      <h2>Mūsu drukas produkti</h2>
    </div>

    <div class="dr-showcase-grid">

      <div class="dr-showcase-card dr-showcase-large">
        <div class="dr-showcase-img">
          <img src="/images/web-design/brosuras-laiksdrukat_new.webp" alt="Brošūras" loading="lazy">
        </div>
        <div class="dr-showcase-label">
          <strong>Brošūras</strong>
          <span>A4 — Piedāvājam skvotu brošūru druku</span>
        </div>
      </div>

      <div class="dr-showcase-card">
        <div class="dr-showcase-img">
          <img src="/images/web-design/flajeri-laiksdrukat_laiks.webp" alt="Skrejlapas" loading="lazy">
        </div>
   
      </div>

      <div class="dr-showcase-card">
        <div class="dr-showcase-img">
          <img src="/images/web-design/etikete_new.webp" alt="Etiķetes" loading="lazy">
        </div>
       
      </div>

      <div class="dr-showcase-card">
        <div class="dr-showcase-img">
          <img src="/images/web-design/plakati_laiks_new.webp" alt="Plakāti" loading="lazy">
        </div>
       
      </div>

      <div class="dr-showcase-card">
        <div class="dr-showcase-img">
          <img src="/images/web-design/kalendars-laiks-drukat-new.webp" alt="Kalendāri" loading="lazy">
        </div>
        
      </div>

    </div>
  </div>
</section>

<!-- DESIGN SECTION -->
<section class="dr-design">
  <div class="container">
    <div class="dr-design-inner">
      <div class="dr-design-copy">
        <span class="dr-eyebrow-dark">Papildus pakalpojumi</span>
        <h2>Maketēšana un dizaina izstrāde</h2>
        <p>Maketēšanas un dizaina izmaksas tiek aprēķinātas, ņemot vērā projekta sarežģītību, darba apjomu un klienta sniegto materiālu kvalitāti.</p>
        <p>Darba procesā ietilpst informācijas apkopošana, dizaina idejas izstrāde, vizuālā noformējuma sagatavošana un failu pielāgošana drukas prasībām.</p>
        <p>Ja nepieciešams, tiek sagatavoti vairāki dizaina varianti, lai atrastu piemērotāko risinājumu.</p>
        <div class="dr-design-prices">
          <div class="dr-design-price">
            <span class="dr-dp-label">Maketēšanas darbu stundas likme</span>
            <span class="dr-dp-val">18–30 €/h</span>
            <span class="dr-dp-note">bez PVN</span>
          </div>
        </div>
        <p class="dr-design-note">Cena var mainīties atkarībā no darba sarežģītības un apjoma. Lielākiem vai ilgtermiņa projektiem izmaksas tiek aprēķinātas individuāli.</p>
      </div>
      <div class="dr-design-visual">
        <div class="dr-design-card">
          <div class="dr-design-step">
            <div class="dr-design-step-num">1</div>
            <div>
              <strong>Informācijas apkopošana</strong>
              <p>Saņemam jūsu materiālus, logo un vēlmes.</p>
            </div>
          </div>
          <div class="dr-design-step">
            <div class="dr-design-step-num">2</div>
            <div>
              <strong>Dizaina izstrāde</strong>
              <p>Veidojam maketu atbilstoši jūsu zīmolam.</p>
            </div>
          </div>
          <div class="dr-design-step">
            <div class="dr-design-step-num">3</div>
            <div>
              <strong>Apstiprināšana</strong>
              <p>Nosūtām maketu pārskatīšanai un komentāriem.</p>
            </div>
          </div>
          <div class="dr-design-step">
            <div class="dr-design-step-num">4</div>
            <div>
              <strong>Sagatavošana drukai</strong>
              <p>Pielāgojam failus visiem drukas tehniskajiem parametriem.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="dr-contact" id="dr-contact">
  <div class="container">
    <div class="dr-contact-inner">
      <div class="dr-contact-copy">
        <span class="dr-eyebrow-dark">Sazināties</span>
        <h2>Saņem piedāvājumu</h2>
        <p>Aizpildiet formu un mēs sazināsimies ar jums, lai apspriestu detaļas un sagatavotu piedāvājumu.</p>
        <div class="dr-contact-tips">
          <div class="dr-tip">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Drukas produkta veids (bukleti, brošūras, flajeri utt.)
          </div>
          <div class="dr-tip">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Izmērs, papīrs un aptuvenā tirāža
          </div>
          <div class="dr-tip">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Vai ir gatavs dizains vai nepieciešama izstrāde
          </div>
          <div class="dr-tip">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Pievienojiet dizaina failu vai logo, ja ir
          </div>
        </div>
        <div class="dr-contact-phones">
          <a href="tel:+37129109703" class="dr-phone-link">
            <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            +371 29 109 703
          </a>
          <a href="mailto:dp@ml.lv" class="dr-phone-link">
            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            dp@ml.lv
          </a>
        </div>
      </div>

      <% if (it.success) { %>
        <div class="vk-success">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#255f31" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <div>
            <strong>Ziņa veiksmīgi nosūtīta!</strong>
            <span>Sazināsimies ar jums pēc iespējas ātrāk.</span>
          </div>
        </div>
      <% } else { %>
       <% if (it.error) { %>
          <div class="vr-error">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <%= it.error %>
          </div>
        <% } %>
        <form action="/pakalpojumi-kontakts" method="POST" enctype="multipart/form-data" class="dr-form">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <input type="hidden" name="returnTo" value="/druka/">
          <div class="dr-form-row">
            <div class="form-group">
              <label class="dr-label">Vārds <span class="required">*</span></label>
              <input type="text" name="name" class="dr-input" required placeholder="Jānis Bērziņš">
            </div>
            <div class="form-group">
              <label class="dr-label">E-pasts <span class="required">*</span></label>
              <input type="email" name="email" class="dr-input" required placeholder="janis@example.lv">
            </div>
          </div>
          <div class="form-group">
            <label class="dr-label">Tālrunis</label>
            <input type="tel" name="phone" class="dr-input" placeholder="+371 2X XXX XXX">
          </div>
          <div class="form-group">
            <label class="dr-label">Jūsu ziņa <span class="required">*</span></label>
            <textarea name="message" class="dr-input dr-textarea" required maxlength="180" data-message-input placeholder="Produkta veids, izmērs, tirāža, vai ir dizains..."></textarea>
            <div style="text-align:right;font-size:12px;color:#a099cc;margin-top:4px;"><span data-message-count>0</span> / 180</div>
          </div>
          <div class="form-group">
            <label class="dr-label">Dizaina fails vai logo</label>
            <label class="upload-dropzone">
              <input type="file" name="attachment" class="upload-dropzone-input" data-file-input accept=".pdf,.jpg,.jpeg,.png,.svg,.ai,.eps,.doc,.docx">
              <span class="upload-dropzone-copy">
                <strong>Pievienot failu</strong>
                <small data-file-label>PDF, AI, EPS, JPG, PNG, SVG</small>
              </span>
            </label>
          </div>
          <button type="submit" class="dr-btn-primary dr-btn-full">
            <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Nosūtīt pieprasījumu
          </button>
        </form>
      <% } %>
    </div>
  </div>
</section>
