<% layout('layout') %>

<div class="admin-page-header">
  <h1>Dashboard</h1>
</div>

<div class="admin-stats">
  <div class="stat-card">
    <div class="stat-value"><%= it.productCount %></div>
    <div class="stat-label">Produkti</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= it.orderCount %></div>
    <div class="stat-label">Pasutijumi kopas</div>
  </div>
  <div class="stat-card stat-card-accent">
    <div class="stat-value"><%= it.pendingOrders %></div>
    <div class="stat-label">Gaida apstradi</div>
  </div>
  <div class="stat-card">
    <div class="stat-value"><%= it.messageCount %></div>
    <div class="stat-label">Kontaktu zinas</div>
  </div>
</div>

<div style="margin-top:40px;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <h2 style="font-size:18px;font-weight:700;">Jaunakie pasutijumi</h2>
    <a href="/admin/orders" class="btn btn-outline btn-sm">Visi pasutijumi</a>
  </div>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Klients</th>
          <th>Summa</th>
          <th>Statuss</th>
          <th>Datums</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% for (const o of it.recentOrders) { %>
          <tr>
            <td style="font-weight:700;">#<%= o.id %></td>
            <td><%= o.name %></td>
            <td style="font-weight:600;"><%= Number(o.pricing.totalWithVat).toFixed(2) %> EUR</td>
            <td><span class="badge badge-<%= o.status.toLowerCase() %>"><%= o.status %></span></td>
            <td style="color:var(--gray-400);font-size:13px;"><%= new Date(o.createdAt).toLocaleDateString('lv-LV') %></td>
            <td><a href="/admin/orders/<%= o.id %>" class="btn btn-sm btn-outline">Skatit</a></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div style="margin-top:40px;">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <h2 style="font-size:18px;font-weight:700;">Jaunakās ziņas</h2>
    <a href="/admin/messages" class="btn btn-outline btn-sm">Visas zinas</a>
  </div>
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Vards</th>
          <th>E-pasts</th>
          <th>Talrunis</th>
          <th>Zina</th>
          <th>Datums</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (it.recentMessages.length === 0) { %>
          <tr>
            <td colspan="6" style="color:var(--gray-400);">Vel nav saņemta neviena kontaktforma.</td>
          </tr>
        <% } %>
        <% for (const message of it.recentMessages) { %>
          <tr>
            <td style="font-weight:700;"><%= message.name %></td>
            <td><%= message.email %></td>
            <td><%= message.phone || '-' %></td>
            <td>
              <% if (message.message.length > 60) { %>
                <%= message.message.slice(0, 60) %>...
              <% } else { %>
                <%= message.message %>
              <% } %>
            </td>
            <td style="color:var(--gray-400);font-size:13px;"><%= new Date(message.createdAt).toLocaleDateString('lv-LV') %></td>
            <td><a href="/admin/messages/<%= message.id %>" class="btn btn-sm btn-outline">Skatit</a></td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<div style="margin-top:24px;display:flex;justify-content:flex-end;">
  <a href="/admin/notification-emails" class="btn btn-outline btn-sm">Pārvaldīt paziņojumu e-pastus</a>
</div>
