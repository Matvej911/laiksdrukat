<% layout('../partials/layout', { bodyClass: 'page-home' }) %>
<% const home = it.t.home %>

<!-- HERO -->
<section class="hero-section">
  <div class="container hero-shell">
    <div class="hero-copy">
      <span class="hero-eyebrow"><%= home.city %></span>
      <h1><%= it.site.home.title %></h1>
      <p><%= it.site.home.intro %></p>
      <div class="hero-actions">
        <a href="<%= it.localizedPath('/kontakti/') %>" class="btn btn-yellow"><%= home.contactCta %></a>
        <a href="<%= it.localizedPath('/veikals/') %>" class="hero-btn-outline"><%= home.shopCta %></a>
      </div>
      <div class="hero-trust">
        <div class="hero-trust-item">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <%= home.trustQuality %>
        </div>
        <div class="hero-trust-item">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <%= home.trustSpeed %>
        </div>
        <div class="hero-trust-item">
          <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <%= home.trustLocation %>
        </div>
      </div>
    </div>
    <div class="hero-visual">
      <img src="<%= it.site.home.heroImage %>" alt="<%= it.site.home.heroAlt %>" class="hero-img" width="960" height="720">
    </div>
  </div>
</section>

<!-- SERVICES -->
<section class="section" id="pakalpojumi">
  <div class="container">
    <div class="section-heading">
      <h2><%= home.servicesHeading %></h2>
    </div>

    <div class="portfolio-grid">
      <% for (const item of it.site.portfolio) { %>
        <a href="<%= it.localizedPath(item.path) %>" class="portfolio-card">
          <img src="<%= item.image %>" alt="<%= item.title %>" width="1200" height="900">
        </a>
      <% } %>
    </div>
  </div>
</section>

<!-- PORTFOLIO -->
<section class="section portfolio-showcase" id="portfolio">
  <div class="container">
    <div class="portfolio-showcase-copy">
      <span class="home-eyebrow-light"><%= home.galleryEyebrow %></span>
      <h2><%= home.galleryTitle %></h2>
      <p><%= home.galleryText %></p>
    </div>
    <div class="home-gallery-slider" data-portfolio-slider>
      <button class="home-gallery-btn left" type="button" onclick="portfolioSlide(this, -1)">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="home-gallery-track-wrap">
        <div class="portfolio-track">
          <% for (const item of it.site.portfolioSlider) { %>
            <div class="portfolio-item <%= item.type %>">
              <img src="<%= item.image %>" alt="<%= item.alt %>" width="1200" height="900">
            </div>
          <% } %>
        </div>
      </div>
      <button class="home-gallery-btn right" type="button" onclick="portfolioSlide(this, 1)">
        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
  <div class="portfolio-waves">
    <svg xmlns="http://www.w3.org/2000/svg" height="100%" viewBox="0 0 283.5 27.8" preserveAspectRatio="xMidYMax slice">
      <path fill="#3A2A97" d="M0 0v1.4c.6.7 1.1 1.4 1.4 2 2 3.8 2.2 6.6 1.8 10.8-.3 3.3-2.4 9.4 0 12.3 1.7 2 3.7 1.4 4.6-.9 1.4-3.8-.7-8.2-.6-12 .1-3.7 3.2-5.5 6.9-4.9 4 .6 4.8 4 4.9 7.4.1 1.8-1.1 7 0 8.5.6.8 1.6 1.2 2.4.5 1.4-1.1.1-5.4.1-6.9.1-3.7.3-8.6 4.1-10.5 5-2.5 6.2 1.6 5.4 5.6-.4 1.7-1 9.2 2.9 6.3 1.5-1.1.7-3.5.5-4.9-.4-2.4-.4-4.3 1-6.5.9-1.4 2.4-3.1 4.2-3 2.4.1 2.7 2.2 4 3.7 1.5 1.8 1.8 2.2 3 .1 1.1-1.9 1.2-2.8 3.6-3.3 1.3-.3 4.8-1.4 5.9-.5 1.5 1.1.6 2.8.4 4.3-.2 1.1-.6 4 1.8 3.4 1.7-.4-.3-4.1.6-5.6 1.3-2.2 5.8-1.4 7 .5 1.3 2.1.5 5.8.1 8.1s-1.2 5-.6 7.4c1.3 5.1 4.4.9 4.3-2.4-.1-4.4-2-8.8-.5-13 .9-2.4 4.6-6.6 7.7-4.5 2.7 1.8.5 7.8.2 10.3-.2 1.7-.8 4.6.2 6.2.9 1.4 2 1.5 2.6-.3.5-1.5-.9-4.5-1-6.1-.2-1.7-.4-3.7.2-5.4 1.8-5.6 3.5 2.4 6.3.6 1.4-.9 4.3-9.4 6.1-3.1.6 2.2-1.3 7.8.7 8.9 4.2 2.3 1.5-7.1 2.2-8 3.1-4 4.7 3.8 6.1 4.1 3.1.7 2.8-7.9 8.1-4.5 1.7 1.1 2.9 3.3 3.2 5.2.4 2.2-1 4.5-.6 6.6 1 4.3 4.4 1.5 4.4-1.7 0-2.7-3-8.3 1.4-9.1 4.4-.9 7.3 3.5 7.8 6.9.3 2-1.5 10.9 1.3 11.3 4.1.6-3.2-15.7 4.8-15.8 4.7-.1 2.8 4.1 3.9 6.6 1 2.4 2.1 1 2.3-.8.3-1.9-.9-3.2 1.3-4.3 5.9-2.9 5.9 5.4 5.5 8.5-.3 2-1.7 8.4 2 8.1 6.9-.5-2.8-16.9 4.8-18.7 4.7-1.2 6.1 3.6 6.3 7.1.1 1.7-1.2 8.1.6 9.1 3.5 2 1.9-7 2-8.4.2-4 1.2-9.6 6.4-9.8 4.7-.2 3.2 4.6 2.7 7.5-.4 2.2 1.3 8.6 3.8 4.4 1.1-1.9-.3-4.1-.3-6 0-1.7.4-3.2 1.3-4.6 1-1.6 2.9-3.5 5.1-2.9 2.5.6 2.3 4.1 4.1 4.9 1.9.8 1.6-.9 2.3-2.1 1.2-2.1 2.1-2.1 4.4-2.4 1.4-.2 3.6-1.5 4.9-.5 2.3 1.7-.7 4.4.1 6.5.6 1.5 2.1 1.7 2.8.3.7-1.4-1.1-3.4-.3-4.8 1.4-2.5 6.2-1.2 7.2 1 2.3 4.8-3.3 12-.2 16.3 3 4.1 3.9-2.8 3.8-4.8-.4-4.3-2.1-8.9 0-13.1 1.3-2.5 5.9-5.7 7.9-2.4 2 3.2-1.3 9.8-.8 13.4.5 4.4 3.5 3.3 2.7-.8-.4-1.9-2.4-10 .6-11.1 3.7-1.4 2.8 7.2 6.5.4 2.2-4.1 4.9-3.1 5.2 1.2.1 1.5-.6 3.1-.4 4.6.2 1.9 1.8 3.7 3.3 1.3 1-1.6-2.6-10.4 2.9-7.3 2.6 1.5 1.6 6.5 4.8 2.7 1.3-1.5 1.7-3.6 4-3.7 2.2-.1 4 2.3 4.8 4.1 1.3 2.9-1.5 8.4.9 10.3 4.2 3.3 3-5.5 2.7-6.9-.6-3.9 1-7.2 5.5-5 4.1 2.1 4.3 7.7 4.1 11.6 0 .8-.6 9.5 2.5 5.2 1.2-1.7-.1-7.7.1-9.6.3-2.9 1.2-5.5 4.3-6.2 4.5-1 7.7 1.5 7.4 5.8-.2 3.5-1.8 7.7-.5 11.1 1 2.7 3.6 2.8 5 .2 1.6-3.1 0-8.3-.4-11.6-.4-4.2-.2-7 1.8-10.8 0 0-.1.1-.1.2-.2.4-.3.7-.4.8v.1c-.1.2-.1.2 0 0v-.1l.4-.8c0-.1.1-.1.1-.2.2-.4.5-.8.8-1.2V0H0zM282.7 3.4z"/>
    </svg>
  </div>
</section>

<!-- PRODUCTS -->
<section class="home-shop">
  <div class="container">
    <div class="home-shop-header">
      <div>
        <span class="home-eyebrow-dark"><%= home.shopEyebrow %></span>
        <h2><%= home.shopTitle %></h2>
        <p><%= home.shopText %></p>
      </div>
      <a href="<%= it.localizedPath('/veikals/') %>" class="home-shop-btn"><%= home.shopButton %></a>
    </div>

    <div class="products-slider-wrapper">
      <button class="slider-btn left" type="button">
        <img src="/images/web-design/angle-left.svg" alt="left" width="24" height="24">
      </button>
      <div class="products-slider-track">
        <div class="products-slider">
          <% for (const p of it.products) { %>
          <article class="product-card">
            <a href="<%= it.localizedPath('/veikals/' + p.slug + '/') %>">
              <div class="product-img">
                <% if (p.image) { %>
                  <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" width="800" height="800">
                <% } else { %>
                  <div class="product-img-placeholder">LD</div>
                <% } %>
              </div>
              <div class="product-info">
                <div class="product-category"><%= p.category.name %></div>
                <div class="product-name"><%= p.name %></div>
                <div class="product-price">
                  <%= Number(p.price).toFixed(2) %> €
                  <span class="product-price-vat"><%= home.vat %></span>
                </div>
              </div>
            </a>
          </article>
          <% } %>
        </div>
      </div>
      <button class="slider-btn right" type="button">
        <img src="/images/web-design/angle-right.svg" alt="right" width="24" height="24">
      </button>
    </div>
  </div>
</section>












