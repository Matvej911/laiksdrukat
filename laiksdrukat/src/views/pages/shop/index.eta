<% layout('../../partials/layout') %>

<section class="page-hero page-hero-compact">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Sākums</a>
      <span class="breadcrumb-sep">/</span>
      <span>Veikals</span>
    </div>

    <div class="page-hero-copy">
      <span class="eyebrow">E-veikals</span>
      <h1>Zīmogi un zīmogu tintes</h1>
      <p><%= it.site.shop.intro %></p>
    </div>

    <div class="category-grid category-grid-compact">
      <a href="/veikals" class="category-card <%= !it.activeCategory ? 'category-card-active' : '' %>">
        <span class="eyebrow">Skats</span>
        <h3>Visas preces</h3>
        <p>Vienā skatā redzami visi pieejamie zīmogi un tintes.</p>
        <div class="category-meta">
          <span><%= it.products.length %> preces filtrā</span>
          <span>Atvērt</span>
        </div>
      </a>

      <% for (const categoryInfo of it.site.shop.categories) { %>
        <% const dbCategory = it.categories.find((category) => category.slug === categoryInfo.slug) %>
        <a href="/veikals/kategorija/<%= categoryInfo.slug %>" class="category-card <%= it.activeCategory === categoryInfo.slug ? 'category-card-active' : '' %>">
          <span class="eyebrow">Kategorija</span>
          <h3><%= categoryInfo.title %></h3>
          <p><%= categoryInfo.description %></p>
          <div class="category-meta">
            <span><%= dbCategory ? dbCategory._count.products : 0 %> preces</span>
            <span>Filtrēt</span>
          </div>
        </a>
      <% } %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <form action="<%= it.activeCategory ? ('/veikals/kategorija/' + it.activeCategory) : '/veikals' %>" method="GET" class="shop-toolbar">
      <div class="shop-toolbar-field">
        <label for="q" class="shop-toolbar-label">Meklēt produktu</label>
        <input id="q" type="search" name="q" value="<%= it.q || '' %>" class="form-input" placeholder="Piemēram, Colop 55 oval">
      </div>

      <div class="shop-toolbar-field">
        <label for="sort" class="shop-toolbar-label">Kārtot</label>
        <select id="sort" name="sort" class="form-input">
          <option value="name-asc" <%= it.sort === 'name-asc' ? 'selected' : '' %>>Pēc nosaukuma</option>
          <option value="price-asc" <%= it.sort === 'price-asc' ? 'selected' : '' %>>Cena: no zemākās</option>
          <option value="price-desc" <%= it.sort === 'price-desc' ? 'selected' : '' %>>Cena: no augstākās</option>
        </select>
      </div>

      <div class="shop-toolbar-actions">
        <button type="submit" class="btn btn-primary">Meklēt</button>
        <a href="<%= it.activeCategory ? ('/veikals/kategorija/' + it.activeCategory) : '/veikals' %>" class="btn btn-outline">Notīrīt</a>
      </div>
    </form>

    <div class="shop-results-meta">
      <strong><%= it.products.length %></strong> produkti
      <% if (it.q) { %>
        <span>Meklēšana: "<%= it.q %>"</span>
      <% } %>
    </div>

    <% if (it.products.length === 0) { %>
      <div class="empty-state">
        <h2>Šajā kategorijā pagaidām nav produktu</h2>
        <p>Ja vajadzīgā prece nav sarakstā, sazinieties ar mums un piemeklēsim piemērotu risinājumu.</p>
        <a href="/kontakti" class="btn btn-primary">Sazināties</a>
      </div>
    <% } else { %>
      <div class="products-grid">
        <% for (const p of it.products) { %>
          <article class="product-card">
            <a href="/veikals/<%= p.slug %>">
              <div class="product-img">
                <% if (p.image) { %>
                  <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
                <% } else { %>
                  <div class="product-img-placeholder">LD</div>
                <% } %>
              </div>
              <div class="product-info">
                <div class="product-category"><%= p.category.name %></div>
                <div class="product-name"><%= p.name %></div>
                <div class="product-price"><%= Number(p.price).toFixed(2) %> € <span class="product-price-vat">+ PVN</span></div>
              </div>
            </a>
            <div class="product-actions">
              <form action="/grozs/add" method="POST">
                <input type="hidden" name="productId" value="<%= p.id %>">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="btn btn-dark btn-full btn-sm">Pievienot grozam</button>
              </form>
            </div>
          </article>
        <% } %>
      </div>
    <% } %>
  </div>
</section>
