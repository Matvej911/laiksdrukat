<!DOCTYPE html>
<html lang="lv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.title || it.site.meta.title %></title>
  <meta name="description" content="<%= it.description || it.site.meta.description %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
  <%~ it.extraHead || '' %>
</head>
<body>

<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <a href="<%= it.site.contact.mapUrl %>" target="_blank" rel="noreferrer"><%= it.site.contact.shortAddress %></a>
      <div class="topbar-links">
        <a href="<%= it.site.contact.phones[0].href %>"><%= it.site.contact.phones[0].label %></a>
        <a href="<%= it.site.contact.emailHref %>"><%= it.site.contact.email %></a>
        <a href="<%= it.site.contact.facebook.url %>" target="_blank" rel="noreferrer"><%= it.site.contact.facebook.label %></a>
      </div>
    </div>
  </div>

  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <span>Laiks Drukāt</span>
      </a>

      <button class="hamburger" type="button" aria-expanded="false" aria-controls="nav-menu">
        Izvēlne
      </button>

      <div class="nav-links" id="nav-menu">
        <div class="dropdown">
          <a href="/#pakalpojumi" class="nav-link">Pakalpojumi</a>
          <div class="dropdown-menu">
            <% for (const service of it.site.services) { %>
              <a href="<%= service.path %>"><%= service.menuTitle %></a>
            <% } %>
          </div>
        </div>
        <a href="/veikals" class="nav-link">Veikals</a>
        <a href="/kontakti" class="nav-link">Kontakti</a>
       
      </div>

      <a href="/grozs" class="nav-cart" aria-label="Skatīt grozu">
        <span>Grozs</span>
        <% const cartCount = (it.cart || []).reduce((sum, item) => sum + item.quantity, 0) %>
        <% if (cartCount > 0) { %>
          <span class="nav-cart-count"><%= cartCount %></span>
        <% } %>
      </a>
    </div>
  </nav>
</header>

<main>
  <%~ it.body %>
</main>





<footer class="footer">
  <div class="footer-waves">
    <svg width="100%" height="100%" viewBox="0 0 1440 390" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
      <path d="M 0,400 L 0,150 C 20.08818493407052,185.58564931035508 40.17636986814104,221.17129862071016 73,211 C 105.82363013185896,200.82870137928984 151.3827054615064,144.9004548275144 180,133 C 208.6172945384936,121.0995451724856 220.2928082858333,153.22688206923223 246,145 C 271.7071917141667,136.77311793076777 311.4460613951604,88.19201689555666 346,76 C 380.5539386048396,63.80798310444334 409.9229461335248,88.00505034854109 437,117 C 464.0770538664752,145.9949496514589 488.8621540707403,179.78778171027903 510,168 C 531.1378459292597,156.21221828972097 548.628437583514,98.8438228103428 579,105 C 609.371562416486,111.1561771896572 652.6240955952037,180.83692704834982 685,201 C 717.3759044047963,221.16307295165018 738.8751800356714,191.80846899625777 760,185 C 781.1248199643286,178.19153100374223 801.875184262111,193.92919696661892 834,177 C 866.124815737889,160.07080303338108 909.6240829158843,110.47474313726654 943,117 C 976.3759170841157,123.52525686273346 999.6284840743522,186.17183048431497 1023,195 C 1046.3715159256478,203.82816951568503 1069.861980786707,158.8379349254736 1101,158 C 1132.138019213293,157.1620650745264 1170.9235927788206,200.47642981379056 1196,221 C 1221.0764072211794,241.52357018620944 1232.44364809801,239.2563458193641 1258,210 C 1283.55635190199,180.7436541806359 1323.3018148291399,124.4981869087531 1356,110 C 1388.6981851708601,95.5018130912469 1414.34909258543,122.75090654562345 1440,150 L 1440,400 L 0,400 Z" fill="#3a2a97" transform="rotate(-180 720 200)"/>
    </svg>
  </div>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="eyebrow">Laiks Drukāt</span>
        <h3>Piedāvājam dažādus drukas un reklāmas risinājumus – no zīmogiem un vizītkartēm līdz banneriem un vides reklāmai.</h3>
        <p>Palīdzam realizēt jūsu idejas ātri un kvalitatīvi.</p>
      </div>

      <div>
        <h4>Pakalpojumi</h4>
        <ul class="footer-links">
          <% for (const service of it.site.services) { %>
            <li><a href="<%= service.path %>"><%= service.menuTitle %></a></li>
          <% } %>
        </ul>
      </div>

      <div>
        <h4>E-veikals</h4>
        <ul class="footer-links">
          <li><a href="/veikals">Visas preces</a></li>
          <li><a href="/veikals/kategorija/zimogi">Zīmogi</a></li>
          <li><a href="/veikals/kategorija/zimogu-tintes">Zīmogu tintes</a></li>
          <li><a href="/grozs">Grozs</a></li>
        </ul>
      </div>

      <div>
        <h4>Kontakti</h4>
        <ul class="footer-links">
          <li><a href="<%= it.site.contact.mapUrl %>" target="_blank" rel="noreferrer"><%= it.site.contact.address %></a></li>
          <% for (const phone of it.site.contact.phones) { %>
            <li><a href="<%= phone.href %>"><%= phone.label %></a></li>
          <% } %>
          <li><a href="<%= it.site.contact.emailHref %>"><%= it.site.contact.email %></a></li>
          <li><a href="<%= it.site.contact.facebook.url %>" target="_blank" rel="noreferrer"><%= it.site.contact.facebook.label %></a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© <%= it.currentYear %> <%= it.site.company.name %> · <%= it.site.company.legalName %> · Reģ. Nr. <%= it.site.company.registrationNumber %></p>
      <p>Jelgava, Latvija</p>
    </div>
  </div>
</footer>

<script src="/js/main.js"></script>
</body>
</html>
