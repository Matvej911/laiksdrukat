<%~ includeFile('partials/layout', { ...it, body: `

<section class="section-sm">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Sākums</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/grozs">Grozs</a>
      <span class="breadcrumb-sep">/</span>
      <span>Pasūtījums</span>
    </div>

    <h1 style="font-size:32px;font-weight:800;margin-bottom:32px;">Noformēt pasūtījumu</h1>

    <div style="display:grid;grid-template-columns:1fr 360px;gap:48px;align-items:start;">
      <div>
        <% if (it.error) { %>
          <div class="form-error"><%= it.error %></div>
        <% } %>

        <form action="/checkout" method="POST">
          <h3 style="font-size:16px;font-weight:700;margin-bottom:20px;padding-bottom:12px;border-bottom:1px solid var(--gray-200);">Kontaktinformācija</h3>

          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">Vārds, uzvārds <span class="required">*</span></label>
              <input type="text" name="name" class="form-input" required value="<%= (it.formData && it.formData.name) || '' %>">
            </div>
            <div class="form-group">
              <label class="form-label">E-pasts <span class="required">*</span></label>
              <input type="email" name="email" class="form-input" required value="<%= (it.formData && it.formData.email) || '' %>">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Tālrunis</label>
            <input type="tel" name="phone" class="form-input" value="<%= (it.formData && it.formData.phone) || '' %>">
          </div>

          <h3 style="font-size:16px;font-weight:700;margin:28px 0 20px;padding-bottom:12px;border-bottom:1px solid var(--gray-200);">Piegādes adrese</h3>

          <div class="form-group">
            <label class="form-label">Adrese</label>
            <input type="text" name="address" class="form-input" placeholder="Iela, mājas nr." value="<%= (it.formData && it.formData.address) || '' %>">
          </div>
          <div class="form-grid">
            <div class="form-group">
              <label class="form-label">Pilsēta</label>
              <input type="text" name="city" class="form-input" value="<%= (it.formData && it.formData.city) || '' %>">
            </div>
            <div class="form-group">
              <label class="form-label">Pasta indekss</label>
              <input type="text" name="zip" class="form-input" value="<%= (it.formData && it.formData.zip) || '' %>">
            </div>
          </div>

          <div class="form-group">
            <label class="form-label">Piezīmes</label>
            <textarea name="note" class="form-input form-textarea" placeholder="Papildu informācija..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="padding:14px 32px;font-size:16px;">
            Apstiprināt pasūtījumu
          </button>
        </form>
      </div>

      <div class="cart-summary">
        <h3 style="font-size:16px;font-weight:700;margin-bottom:20px;">Jūsu pasūtījums</h3>
        <% for (const item of it.cart) { %>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;font-size:14px;">
            <div>
              <div style="font-weight:500;"><%= item.name %></div>
              <div style="color:var(--gray-400);">x <%= item.quantity %></div>
            </div>
            <div style="font-weight:600;"><%= (item.price * item.quantity).toFixed(2) %> EUR</div>
          </div>
        <% } %>
        <div style="border-top:1px solid var(--gray-200);margin:16px 0;"></div>
        <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px;">
          <span style="color:var(--gray-600);">Bez PVN</span>
          <span><%= it.total.toFixed(2) %> EUR</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:12px;">
          <span style="color:var(--gray-600);">PVN 21%</span>
          <span><%= (it.total * 0.21).toFixed(2) %> EUR</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-weight:800;font-size:18px;">
          <span>Kopā</span>
          <span style="color:var(--accent);"><%= (it.total * 1.21).toFixed(2) %> EUR</span>
        </div>
        <div style="margin-top:20px;padding:12px;background:var(--gray-100);border-radius:var(--radius);font-size:13px;color:var(--gray-600);">
          Maksajums tiek kartots pec pasutijuma apstiprsinasanas
        </div>
      </div>
    </div>
  </div>
</section>

`}) %>
