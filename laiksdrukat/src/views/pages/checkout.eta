<% layout('../partials/layout') %>
<% const formData = it.formData || {} %>
<% const totalVat = Number(it.total) * 0.21 %>
<% const totalWithVat = Number(it.total) + totalVat %>

<section class="page-hero page-hero-compact">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Sākums</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/grozs">Grozs</a>
      <span class="breadcrumb-sep">/</span>
      <span>Pasūtījums</span>
    </div>
  </div>
</section>

<section class="section">
  <div class="container checkout-layout">
    <div class="checkout-form-card">
      <div class="checkout-section-head">
        <span class="eyebrow">Informācija</span>
        <h1>Noformēt pasūtījumu</h1>
        <p>Aizpildiet savus datus, un mēs sazināsimies ar jums par pasūtījuma apstiprināšanu.</p>
      </div>

      <% if (it.error) { %>
        <div class="form-error"><%= it.error %></div>
      <% } %>

      <form action="/checkout" method="POST" class="checkout-form">
        <div class="form-grid">
          <div class="form-group">
            <label class="form-label">Vārds <span class="required">*</span></label>
            <input type="text" name="firstName" class="form-input" required value="<%= formData.firstName || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">Uzvārds <span class="required">*</span></label>
            <input type="text" name="lastName" class="form-input" required value="<%= formData.lastName || '' %>">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Valsts / Reģions <span class="required">*</span></label>
          <select name="country" class="form-input">
            <option value="Latvija" <%= (formData.country || 'Latvija') === 'Latvija' ? 'selected' : '' %>>Latvija</option>
          </select>
        </div>

        <div class="form-group">
          <label class="form-label">Ielas nosaukums <span class="required">*</span></label>
          <input type="text" name="address" class="form-input" required placeholder="Mājas numurs un ielas nosaukums" value="<%= formData.address || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">Pilsēta <span class="required">*</span></label>
          <input type="text" name="city" class="form-input" required value="<%= formData.city || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">Pasta indekss <span class="required">*</span></label>
          <input type="text" name="zip" class="form-input" required value="<%= formData.zip || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">Tālrunis (nav obligāts)</label>
          <input type="tel" name="phone" class="form-input" value="<%= formData.phone || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">Epasta adrese <span class="required">*</span></label>
          <input type="email" name="email" class="form-input" required value="<%= formData.email || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">Papildu informācija</label>
          <textarea name="note" class="form-input form-textarea" placeholder="Piezīmes par pasūtījumu, piegādi vai rekvizītiem."><%= formData.note || '' %></textarea>
        </div>

        <div class="checkout-payment-box">
          <h3>Maksājuma veids</h3>
          <label class="checkout-radio">
            <input type="radio" name="paymentMethod" value="Tiešais bankas pārskaitījums" <%= !formData.paymentMethod || formData.paymentMethod === 'Tiešais bankas pārskaitījums' ? 'checked' : '' %>>
            <span>
              <strong>Tiešais bankas pārskaitījums</strong>
              <small>Veiciet maksājumu uz mūsu bankas kontu pēc pasūtījuma apstiprināšanas.</small>
            </span>
          </label>
          <label class="checkout-radio">
            <input type="radio" name="paymentMethod" value="Skaidrā naudā pēc piegādes" <%= formData.paymentMethod === 'Skaidrā naudā pēc piegādes' ? 'checked' : '' %>>
            <span>
              <strong>Skaidrā naudā pēc piegādes</strong>
              <small>Norēķins pie preces saņemšanas vai iepriekš saskaņojot ar mums.</small>
            </span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-full checkout-submit">Veikt pasūtījumu</button>
      </form>
    </div>

    <aside class="checkout-summary-card">
      <h2>Jūsu pasūtījums</h2>

      <div class="checkout-summary-head">
        <span>Produkts</span>
        <span>Cena ar PVN</span>
      </div>

      <div class="checkout-item-list">
        <% for (const item of it.cart) { %>
          <article class="checkout-item">
            <div class="checkout-item-main">
              <% if (item.image) { %>
                <img src="<%= item.image %>" alt="<%= item.name %>" class="checkout-item-image" loading="lazy">
              <% } else { %>
                <div class="checkout-item-image checkout-item-image-placeholder">LD</div>
              <% } %>

              <div class="checkout-item-copy">
                <div class="checkout-item-name"><%= item.name %> × <%= item.quantity %></div>

                <% if (item.options && Object.keys(item.options).length > 0) { %>
                  <div class="checkout-item-options">
                    <% for (const [key, value] of Object.entries(item.options)) { %>
                      <% if (key !== 'Faila saite') { %>
                        <div><strong><%= key %>:</strong> <%= value %></div>
                      <% } %>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>

            <div class="checkout-item-price">
              <strong><%= (Number(item.price) * item.quantity * 1.21).toFixed(2) %> €</strong>
              <span>(iesk. PVN)</span>
            </div>
          </article>
        <% } %>
      </div>

      <div class="checkout-total-list">
        <div>
          <span>Bez PVN</span>
          <strong><%= Number(it.total).toFixed(2) %> €</strong>
        </div>
        <div>
          <span>PVN 21%</span>
          <strong><%= totalVat.toFixed(2) %> €</strong>
        </div>
        <div class="checkout-total-row">
          <span>Cena ar PVN</span>
          <strong><%= totalWithVat.toFixed(2) %> €</strong>
        </div>
      </div>
    </aside>
  </div>
</section>
