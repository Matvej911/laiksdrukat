<% layout('../partials/layout') %>

<section class="section">
  <div class="container thankyou-shell">
    <div class="thankyou-card">
      <span class="eyebrow">Pasūtījums saņemts</span>
      <h1>Paldies par pasūtījumu!</h1>
      <p>Mēs esam saņēmuši jūsu pieteikumu un drīzumā sazināsimies, lai apstiprinātu detaļas.</p>

      <% if (it.order) { %>
        <div class="thankyou-order-card">
          <div class="thankyou-order-id">Pasūtījuma numurs: #<%= it.order.publicId || it.order.id %></div>

          <div class="thankyou-order-items">
            <% for (const item of it.order.items) { %>
              <div class="thankyou-order-row">
                <span><%= item.name %> × <%= item.quantity %></span>
                <strong><%= (Number(item.price) * item.quantity * 1.21).toFixed(2) %> €</strong>
              </div>
            <% } %>
          </div>

          <div class="thankyou-order-total">
            <span>Kopā ar PVN</span>
            <strong><%= (Number(it.order.total) * 1.21).toFixed(2) %> €</strong>
          </div>
        </div>
      <% } %>

      <div class="thankyou-actions">
        <a href="/veikals" class="btn btn-primary">Atpakaļ uz veikalu</a>
        <a href="/kontakti" class="btn btn-outline">Sazināties ar mums</a>
      </div>
    </div>
  </div>
</section>
