<% layout('../partials/layout', { bodyClass: 'page-home' }) %>
<% const formData = it.formData || {} %>

<!-- HERO -->
<section class="contact-hero-section">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Sākums</a>
      <span class="breadcrumb-sep">/</span>
      <span>Kontakti</span>
    </div>
    <div class="contact-hero-inner">
      <div class="contact-hero-copy">
        <span class="contact-eyebrow">Kontakti</span>
        <h1>Sazinieties ar mums</h1>
        <p>Vienmēr gatavi palīdzēt ar jūsu jautājumiem un pasūtījumiem.</p>
        <div class="contact-hero-pills">
          <a href="<%= it.site.contact.phones[0].href %>" class="contact-hero-pill">
            <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <%= it.site.contact.phones[0].label %>
          </a>
          <a href="<%= it.site.contact.emailHref %>" class="contact-hero-pill">
            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <%= it.site.contact.email %>
          </a>
          <a href="<%= it.site.contact.mapUrl %>" class="contact-hero-pill" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <%= it.site.contact.shortAddress %>
          </a>
        </div>
      </div>
      <div class="contact-hero-info">
        <div class="contact-info-card">
          <div class="contact-info-row">
            <span class="contact-info-label">Pirmdiena – Ceturtdiena</span>
            <span class="contact-info-value">8:00 – 17:00</span>
          </div>
          <div class="contact-info-row">
            <span class="contact-info-label">Piektdiena</span>
            <span class="contact-info-value">8:00 – 16:00</span>
          </div>
          <div class="contact-info-row">
            <span class="contact-info-label">Sestdiena – Svētdiena</span>
            <span class="contact-info-value">Slēgts</span>
          </div>
          <div class="contact-info-divider"></div>
          <% for (const phone of it.site.contact.phones) { %>
            <a href="<%= phone.href %>" class="contact-info-link">
              <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <%= phone.label %>
            </a>
          <% } %>
          <a href="<%= it.site.contact.emailHref %>" class="contact-info-link">
            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <%= it.site.contact.email %>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MAP + FORM -->
<section class="contact-main-section">
  <div class="container contact-main-grid">

    <!-- MAP -->
    <div class="contact-map-block">
      <div class="contact-map-frame">
        <iframe
          src="<%= it.site.contact.mapEmbedUrl %>"
          title="Laiks Drukāt atrašanās vieta kartē"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <div class="contact-map-footer">
        <div class="contact-map-address">
          <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span><%= it.site.contact.address %></span>
        </div>
        <a href="<%= it.site.contact.mapUrl %>" class="btn btn-outline" target="_blank" rel="noreferrer">Google Maps</a>
      </div>
    </div>

    <!-- FORM -->
    <div class="contact-form-block">
      <span class="contact-eyebrow">Sūtīt ziņu</span>
      <h2>Nosūtīt pieprasījumu</h2>
      <p>Atbildēsim pēc iespējas ātrāk.</p>

      <% if (it.success) { %>
        <div class="contact-success">Ziņa veiksmīgi nosūtīta. Sazināsimies ar jums pēc iespējas ātrāk.</div>
      <% } %>
      <% if (it.error) { %>
        <div class="form-error"><%= it.error %></div>
      <% } %>

      <form action="/kontakti" method="POST" enctype="multipart/form-data" class="contact-form">
        <div class="contact-form-row">
          <div class="form-group">
            <label class="form-label">Vārds <span class="required">*</span></label>
            <input type="text" name="name" class="form-input" required value="<%= formData.name || '' %>">
          </div>
          <div class="form-group">
            <label class="form-label">E-pasts <span class="required">*</span></label>
            <input type="email" name="email" class="form-input" required value="<%= formData.email || '' %>">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">Tālrunis</label>
          <input type="tel" name="phone" class="form-input" value="<%= formData.phone || '' %>">
        </div>

        <div class="form-group">
          <div class="form-label-row">
            <label class="form-label">Jūsu ziņa <span class="required">*</span></label>
            <span class="character-count"><span data-message-count><%= (formData.message || '').length %></span> / 180</span>
          </div>
          <textarea
            name="message"
            class="form-input form-textarea contact-message-input"
            maxlength="180"
            required
            data-message-input
          ><%= formData.message || '' %></textarea>
        </div>

        <div class="form-group">
          <label class="form-label">Faila pielikums</label>
          <label class="upload-dropzone">
            <input type="file" name="attachment" class="upload-dropzone-input" data-file-input accept=".pdf,.jpg,.jpeg,.png,.svg,.ai,.eps,.doc,.docx">
            <span class="upload-dropzone-copy">
              <strong>Pievienot failu</strong>
              <small data-file-label>Izvēlieties failu vai ievelciet to šeit</small>
            </span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-full">Nosūtīt pieprasījumu</button>
      </form>
    </div>

  </div>
</section>