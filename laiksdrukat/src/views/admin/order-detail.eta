<% layout('layout') %>

<div class="admin-page-header admin-header-modern">
  <div>
    <h1>Pasūtījums #<%= it.order.id %></h1>
    <span class="admin-subtle">
      Izveidots: <%= new Date(it.order.createdAt).toLocaleString('lv-LV') %>
    </span>
  </div>

  <a href="/admin/orders" class="btn btn-outline btn-sm">Atpakaļ</a>
</div>

<div class="admin-layout">

  <!-- LEFT -->
  <div class="admin-main">

    <!-- PRODUCTS -->
    <div class="admin-card admin-card-modern">
      <h3>Preces</h3>

      <% for (const item of it.order.items) { %>
        <div class="admin-product">

          <div class="admin-product-info">
            <strong><%= item.name %></strong>

              <% if (item.options) { %>
                <div style="margin-top:6px;font-size:13px;color:#6b6490;">

                  <% for (const [key, value] of Object.entries(item.options)) { %>

                    <% if (key === 'Faila saite') { %>
                      <div>
                        📎 
                        <a href="<%= value %>" target="_blank" style="color:#5f4bd8;font-weight:600;">
                          Atvērt failu
                        </a>
                      </div>

                    <% } else if (key !== 'Fails') { %>
                      <div><strong><%= key %>:</strong> <%= value %></div>
                    <% } %>

                  <% } %>

                </div>
              <% } %>
            </div>

          <div class="admin-product-meta">
            <div><%= item.quantity %> ×</div>
            <div><%= Number(item.price).toFixed(2) %> €</div>
            <div class="admin-product-total">
              <%= (Number(item.price) * item.quantity).toFixed(2) %> €
            </div>
          </div>

        </div>
      <% } %>

      <!-- TOTAL -->
      <%
        const isOmniva = it.order.note && it.order.note.includes('Omniva')
        const cartSubtotal = Number(it.order.total) - (isOmniva ? 3.5 : 0)
        const adminTotal = cartSubtotal * 1.21 + (isOmniva ? 3.5 : 0)
      %>

      <div class="admin-total-box">
        <span>Kopā ar PVN</span>
        <strong><%= adminTotal.toFixed(2) %> €</strong>
      </div>
    </div>

    <!-- CUSTOMER -->
    <div class="admin-card admin-card-modern">
      <h3>Klienta informācija</h3>

      <div class="admin-meta-grid">
        <div>
          <span>Vārds</span>
          <strong><%= it.order.name %></strong>
        </div>
        <div>
          <span>E-pasts</span>
          <strong><%= it.order.email %></strong>
        </div>
        <div>
          <span>Tālrunis</span>
          <strong><%= it.order.phone || '-' %></strong>
        </div>
        <div>
          <span>Adrese</span>
          <strong>
            <%= it.order.address || '-' %>
            <% if (it.order.city) { %>, <%= it.order.city %><% } %>
            <% if (it.order.zip) { %>, <%= it.order.zip %><% } %>
          </strong>
        </div>
      </div>

      <% if (it.order.note) { %>
        <div class="admin-note">
          <strong>Piezīme</strong>
          <p><%= it.order.note %></p>
        </div>
      <% } %>
    </div>

  </div>

  <!-- RIGHT -->
  <div class="admin-side">

    <div class="admin-card admin-card-modern">
      <h3>Statuss</h3>

      <div class="admin-status">
        <span class="badge badge-<%= it.order.status.toLowerCase() %>">
          <%= it.order.status %>
        </span>
      </div>

      <form action="/admin/orders/<%= it.order.id %>/status" method="POST">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">

        <select name="status" class="form-input">
          <option value="PENDING" <%= it.order.status === 'PENDING' ? 'selected' : '' %>>PENDING</option>
          <option value="CONFIRMED" <%= it.order.status === 'CONFIRMED' ? 'selected' : '' %>>CONFIRMED</option>
          <option value="SHIPPED" <%= it.order.status === 'SHIPPED' ? 'selected' : '' %>>SHIPPED</option>
          <option value="DONE" <%= it.order.status === 'DONE' ? 'selected' : '' %>>DONE</option>
          <option value="CANCELLED" <%= it.order.status === 'CANCELLED' ? 'selected' : '' %>>CANCELLED</option>
        </select>

        <button class="btn btn-primary btn-full">Mainīt statusu</button>
      </form>
    </div>

  </div>

</div>