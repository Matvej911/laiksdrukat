<div style="background:#f5f4fe;padding:40px 0;font-family:Arial,sans-serif;">
  <table align="center" width="600" style="background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 10px 40px rgba(95,75,216,0.15);">

    <!-- HEADER -->
    <tr>
      <td style="background:linear-gradient(135deg,#5f4bd8,#3a2a97);padding:30px;text-align:center;color:#fff;">
        <div style="font-size:12px;letter-spacing:2px;color:#ffd400;font-weight:700;">
          PASŪTĪJUMS SAŅEMTS
        </div>
        <h1 style="margin:10px 0 0;font-size:24px;">
          Paldies par pasūtījumu!
        </h1>
        <p style="margin:8px 0 0;color:rgba(255,255,255,0.7);">
          #<%= it.orderReference %>
        </p>
      </td>
    </tr>

    <!-- BODY -->
    <tr>
      <td style="padding:30px;">

        <p style="font-size:14px;color:#6b6490;">
          Esam saņēmuši jūsu pasūtījumu un drīzumā sazināsimies.
        </p>

        <!-- ITEMS -->
        <h3 style="color:#1a1464;">Pasūtījuma kopsavilkums</h3>

        <% for (const item of it.cart) { %>
          <table width="100%" style="margin-bottom:12px;border-bottom:1px solid #eee;padding-bottom:8px;">
            <tr>
              <td style="font-size:14px;color:#1a1464;">
                <strong><%= item.name %></strong><br>
                <span style="color:#a099cc;font-size:12px;">
                  Daudzums: <%= item.quantity %>
                </span>
              </td>
              <td align="right" style="font-weight:700;color:#5f4bd8;">
                <%= (Number(item.price) * item.quantity * 1.21).toFixed(2) %> €
              </td>
            </tr>
          </table>
        <% } %>

        <!-- TOTAL CARD -->
        <table width="100%" style="margin-top:20px;background:#f9f8fe;border-radius:12px;padding:16px;">
          <tr>
            <td style="color:#6b6490;">Bez PVN</td>
            <td align="right"><%= it.subtotal.toFixed(2) %> €</td>
          </tr>
          <tr>
            <td style="color:#6b6490;">Piegāde</td>
            <td align="right"><%= it.shipping.toFixed(2) %> €</td>
          </tr>
          <tr>
            <td style="color:#6b6490;">PVN (21%)</td>
            <td align="right"><%= it.totalVat.toFixed(2) %> €</td>
          </tr>
          <tr>
            <td style="padding-top:10px;font-weight:800;color:#1a1464;">Kopā</td>
            <td align="right" style="padding-top:10px;font-weight:800;color:#5f4bd8;font-size:18px;">
              <%= it.totalWithVat.toFixed(2) %> €
            </td>
          </tr>
        </table>

      </td>
    </tr>

    <!-- CTA -->
    <tr>
      <td style="padding:20px;text-align:center;">
        <a href="https://www.laiksdrukat.lv"
           style="display:inline-block;background:#ffd400;color:#1a1464;padding:12px 24px;border-radius:12px;font-weight:700;text-decoration:none;">
          Atgriezties veikalā
        </a>
      </td>
    </tr>

    <!-- FOOTER -->
    <tr>
      <td style="background:#f5f4fe;padding:20px;text-align:center;font-size:12px;color:#a099cc;">
        © Laiks Drukāt • Latvija
      </td>
    </tr>

  </table>
</div>