<% layout('../../partials/layout', { bodyClass: 'page-auto' }) %>
<% const isRu = it.locale === 'ru' %>
<% const servicePage = it.t.servicePage %>
<% const contact = it.t.contact %>

<!-- HERO -->
<section class="au-hero">
  <div class="container">
    <%~ include('../../partials/breadcrumbs', { breadcrumbs: it.breadcrumbs }) %>
    <div class="au-hero-inner">
      <div class="au-hero-copy">
        <span class="au-eyebrow"><%= isRu ? 'Услуга' : 'Pakalpojums' %></span>
        <h1><%= it.service.title %></h1>
        <p><%= it.service.intro %></p>
        <div class="au-hero-actions">
          <a href="#au-prices" class="au-btn-secondary"><%= isRu ? 'Смотреть цены' : 'Skatīt cenas' %></a>
          <a href="#au-contact" class="au-btn-primary"><%= isRu ? 'Написать нам' : 'Rakstīt mums' %></a>
        </div>
        <div class="au-hero-stats">
          <div class="au-stat">
            <span class="au-stat-num">3M</span>
              <span class="au-stat-label"><%= isRu ? 'и плёнки Oracal' : 'un Oracal plēves' %></span>
          </div>
          <div class="au-stat-divider"></div>
          <div class="au-stat">
            <span class="au-stat-num">2–4h</span>
              <span class="au-stat-label"><%= isRu ? 'для простых работ' : 'vienkāršiem darbiem' %></span>
          </div>
          <div class="au-stat-divider"></div>
          <div class="au-stat">
            <span class="au-stat-num">100%</span>
              <span class="au-stat-label"><%= isRu ? 'индивидуально' : 'individuāli' %></span>
          </div>
        </div>
      </div>
      <div class="au-hero-visual">
        <div class="au-car-wrap">
          <img src="/images/web-design/car-mockup.png" alt="Auto aplīmēšana" loading="lazy" class="au-car-img">
          <div class="au-car-glow"></div>
          <div class="au-floating-badge au-badge-1">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <%= isRu ? 'Материал 3M' : '3M materiāls' %>
          </div>
          <div class="au-floating-badge au-badge-2">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <%= isRu ? '2–3 часа' : '2-3 stundas' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="au-features">
  <div class="container">
    <div class="au-section-header center">
      <span class="au-eyebrow-dark"><%= isRu ? 'Преимущества услуги' : 'Pakalpojuma priekšrocības' %></span>
      <h2><%= isRu ? 'Почему выбирают нас' : 'Kāpēc izvēlēties mūs' %></h2>
    </div>
    <div class="au-features-grid">
      <div class="au-feature">
        <div class="au-feature-icon">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3><%= isRu ? 'Качественные материалы' : 'Augstas kvalitātes materiāli' %></h3>
        <p><%= isRu ? 'Используем виниловые плёнки 3M и Oracal, которые дают насыщенный цвет, стойкость и долговечный результат.' : 'Izmantotas 3M un Oracal vinila plēves, kas nodrošina spilgtas krāsas, izturību un ilgstošu rezultātu.' %></p>
      </div>
      <div class="au-feature">
        <div class="au-feature-icon">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3><%= isRu ? 'Быстрый результат' : 'Ātrs rezultāts' %></h3>
        <p><%= isRu ? 'Для небольших проектов оклейка обычно занимает 2–4 часа.' : 'Plēves uzklāšana notiek 2–4 stundu laikā nelieliem auto dizainiem.' %></p>
      </div>
      <div class="au-feature">
        <div class="au-feature-icon">
          <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <h3><%= isRu ? 'Индивидуальные решения' : 'Individuāli risinājumi' %></h3>
        <p><%= isRu ? 'Каждый автомобиль или витрина оформляется по вашей идее, с индивидуальными цветами, формами и стилем.' : 'Katrs auto vai logs tiek aplīmēts pēc jūsu dizaina idejām, ar pielāgotām krāsām, formām un stiliem.' %></p>
      </div>
    </div>
  </div>
</section>

<!-- GALLERY -->
<section class="au-gallery">
  <div class="container">
    <div class="au-section-header">
      <span class="au-eyebrow-dark"><%= isRu ? 'Примеры работ' : 'Darbu piemēri' %></span>
      <h2><%= isRu ? 'Наши работы' : 'Mūsu darbi' %></h2>
    </div>
    <div class="au-gallery-slider" data-portfolio-slider>
      <button class="au-gallery-btn left" type="button" onclick="portfolioSlide(this, -1)">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <div class="au-gallery-track-wrap">
        <div class="portfolio-track" id="auGalleryTrack">
          <% for (const item of it.site.autoGalleryTrack) { %>
            <div class="portfolio-item <%= item.type %>">
              <img src="<%= item.image %>" alt="<%= item.alt %>">
            </div>
          <% } %>
        </div>
      </div>
      <button class="au-gallery-btn right" type="button" onclick="portfolioSlide(this, 1)">
        <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>
</section>

<!-- PRICES -->
<section class="au-prices" id="au-prices">
  <div class="container">
    <div class="au-section-header center">
      <span class="au-eyebrow-dark"><%= isRu ? 'Цены' : 'Cenas' %></span>
      <h2><%= isRu ? 'Виды оклейки' : 'Aplīmēšanas pakalpojumi' %></h2>
    </div>

    <div class="au-price-block">
      <div class="au-price-img">
        <img src="/images/web-design/autostartaplim.webp" alt="Logo un info" loading="lazy">
        <div class="au-price-tag">no €50</div>
      </div>
      <div class="au-price-copy">
        <div class="au-price-num">01</div>
        <h3><%= isRu ? 'Логотип + контакты' : 'Logo + info' %></h3>
        <p><%= isRu ? 'Разместим ваш логотип на бортах и капоте автомобиля, а сзади добавим хорошо заметную контактную информацию, чтобы вас легче запомнили и нашли.' : 'Uzlīmēsim jūsu logotipu uz auto sāniem un motora pārsega, bet aizmugurē izvietosim skaidri redzamu kontaktinformāciju — lai klienti jūs pamana un viegli sazinās.' %></p>
        <div class="au-price-amount">
          <span class="au-price-from"><%= isRu ? 'Ориентировочная стоимость' : 'Aptuvenās izmaksas' %></span>
          <span class="au-price-value">sākot no €50</span>
        </div>
        <a href="#au-contact" class="au-btn-primary"><%= isRu ? 'Написать нам' : 'Rakstīt mums' %></a>
      </div>
    </div>

    <div class="au-price-block au-price-block-reverse">
      <div class="au-price-img">
        <img src="/images/web-design/autoaplimwid.webp" alt="Daļēja aplīmēšana" loading="lazy">
        <div class="au-price-tag">€300–€650</div>
      </div>
      <div class="au-price-copy">
        <div class="au-price-num">02</div>
        <h3><%= isRu ? 'Частичная оклейка автомобиля' : 'Daļēja auto aplīmēšana' %></h3>
        <p><%= isRu ? 'Оклеиваем до 50% кузова и остекления автомобиля. Это заметное рекламное решение, которое сохраняет аккуратный общий вид машины.' : 'Aplīmējam līdz pat 50% no automašīnas virsbūves un logu laukuma — efektīvs veids, kā izcelt dizainu un reklāmu, saglabājot sabalansētu kopskatu.' %></p>
        <div class="au-price-amount">
          <span class="au-price-from"><%= isRu ? 'Ориентировочная стоимость' : 'Aptuvenās izmaksas' %></span>
          <span class="au-price-value">€300 – €650</span>
        </div>
        <a href="#au-contact" class="au-btn-primary"><%= isRu ? 'Написать нам' : 'Rakstīt mums' %></a>
      </div>
    </div>

    <div class="au-price-block">
      <div class="au-price-img">
        <img src="/images/web-design/autofullaplim1.webp" alt="Pilna aplīmēšana" loading="lazy">
        <div class="au-price-tag">€1000–€2000</div>
      </div>
      <div class="au-price-copy">
        <div class="au-price-num">03</div>
        <h3><%= isRu ? 'Полная оклейка автомобиля' : 'Pilna auto aplīmēšana' %></h3>
        <p><%= isRu ? 'Полностью оклеиваем кузов автомобиля для максимального визуального эффекта и цельного фирменного образа.' : 'Pilnībā pārklājam automašīnas virsbūvi — maksimālai vizuālai ietekmei un vienotam izskatam.' %></p>
        <div class="au-price-amount">
          <span class="au-price-from"><%= isRu ? 'Ориентировочная стоимость' : 'Aptuvenās izmaksas' %></span>
          <span class="au-price-value">€1000 – €2000</span>
        </div>
        <a href="#au-contact" class="au-btn-primary"><%= isRu ? 'Написать нам' : 'Rakstīt mums' %></a>
      </div>
    </div>

    <div class="au-price-note">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      <%= isRu ? 'Цены ориентировочные и зависят от размера автомобиля, сложности дизайна и выбранных материалов. Точное предложение подготовим после оценки проекта.' : 'Cenas ir orientējošas un atkarīgas no automašīnas izmēra, dizaina sarežģītības un materiālu izvēles. Precīzu piedāvājumu sagatavosim pēc projekta apskates.' %>
    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="au-process">
  <div class="container">
    <div class="au-section-header center">
      <span class="au-eyebrow-dark"><%= isRu ? 'Как мы работаем' : 'Kā strādājam' %></span>
      <h2><%= isRu ? 'Этапы работы' : 'Darba process' %></h2>
    </div>
    <div class="au-process-steps">
      <div class="au-process-step">
        <div class="au-process-num">1</div>
        <h4><%= isRu ? 'Консультация' : 'Konsultācija' %></h4>
        <p><%= isRu ? 'Обсуждаем задачу, формат оклейки и желаемый результат.' : 'Apspriežam jūsu vajadzības un vēlamo rezultātu.' %></p>
      </div>
      <div class="au-process-arrow">→</div>
      <div class="au-process-step">
        <div class="au-process-num">2</div>
        <h4><%= isRu ? 'Замеры' : 'Izmēru noteikšana' %></h4>
        <p><%= isRu ? 'Перед подготовкой макета снимаем размеры кузова и нужных зон оклейки.' : 'Pirms maketa izstrādes nosakām auto virsbūves izmērus.' %></p>
      </div>
      <div class="au-process-arrow">→</div>
      <div class="au-process-step">
        <div class="au-process-num">3</div>
        <h4><%= isRu ? 'Дизайн' : 'Dizains' %></h4>
        <p><%= isRu ? 'Готовим макет и отправляем его вам на согласование.' : 'Sagatavosim maketu un nosūtīsim apstiprināšanai.' %></p>
      </div>
      <div class="au-process-arrow">→</div>
      <div class="au-process-step">
        <div class="au-process-num">4</div>
        <h4><%= isRu ? 'Печать плёнки' : 'Plēves druka' %></h4>
        <p><%= isRu ? 'Печатаем ваш дизайн на качественной виниловой плёнке.' : 'Drukājam uz vinila plēvi ar jūsu dizainu.' %></p>
      </div>
      <div class="au-process-arrow">→</div>
      <div class="au-process-step">
        <div class="au-process-num">5</div>
        <h4><%= isRu ? 'Оклейка' : 'Uzklāšana' %></h4>
        <p><%= isRu ? 'Аккуратно наносим плёнку на автомобиль, обычно за 2–4 часа.' : 'Uzklājam plēvi uz automašīnas 2–4 stundu laikā.' %></p>
      </div>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section class="au-contact" id="au-contact">
  <div class="container">
    <div class="au-contact-inner">
      <div class="au-contact-copy">
        <span class="au-eyebrow-dark"><%= isRu ? 'Связаться с нами' : 'Sazināties' %></span>
        <h2><%= servicePage.contactTitle %></h2>
        <p><%= isRu ? 'Оставьте сообщение, и мы свяжемся с вами, чтобы обсудить формат оклейки, материалы и сроки.' : 'Aizpildiet formu un mēs sazināsimies ar jums, lai apspriestu detaļas un sagatavotu piedāvājumu.' %></p>
        <div class="au-contact-tips">
          <div class="au-tip">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            <%= isRu ? 'Тип оклейки: логотип, частичная или полная' : 'Aplīmēšanas veids (logo, daļēja vai pilna)' %>
          </div>
          <div class="au-tip">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            <%= isRu ? 'Есть ли готовый дизайн или нужна разработка' : 'Vai ir gatavs dizains vai nepieciešama izstrāde' %>
          </div>
          <div class="au-tip">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            <%= isRu ? 'Прикрепите файл дизайна или логотип, если он уже есть' : 'Pievienojiet dizaina failu vai logo, ja ir' %>
          </div>
        </div>
        <div class="au-contact-phones">
          <a href="tel:+37129109703" class="au-phone-link">
            <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            +371 29 109 703
          </a>
          <a href="mailto:dp@ml.lv" class="au-phone-link">
            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            dp@ml.lv
          </a>
        </div>
      </div>

      <% if (it.success) { %>
        <div class="vr-success">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#255f31" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <div>
            <strong><%= servicePage.contactSuccess %></strong>
          </div>
        </div>
      <% } else { %>
        <% if (it.error) { %>
          <div class="vr-error">
            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <%= it.error %>
          </div>
        <% } %>
        <form action="<%= it.localizedPath('/pakalpojumi-kontakts') %>" method="POST" enctype="multipart/form-data" class="au-form">
          <input type="hidden" name="_csrf" value="<%= it.csrf %>">
          <input type="hidden" name="returnTo" value="<%= it.localizedPath(it.service.path) %>">
          <div class="au-form-row">
            <div class="form-group">
              <label class="au-label"><%= contact.name %> <span class="required">*</span></label>
              <input type="text" name="name" class="au-input" required placeholder="<%= isRu ? 'Иван Петров' : 'Jānis Bērziņš' %>">
            </div>
            <div class="form-group">
              <label class="au-label"><%= contact.email %> <span class="required">*</span></label>
              <input type="email" name="email" class="au-input" required placeholder="<%= isRu ? 'ivan@example.lv' : 'janis@example.lv' %>">
            </div>
          </div>
          <div class="form-group">
            <label class="au-label"><%= contact.phone %></label>
            <input type="tel" name="phone" class="au-input" placeholder="+371 2X XXX XXX">
          </div>
          <div class="form-group">
            <label class="au-label"><%= contact.message %> <span class="required">*</span></label>
            <textarea name="message" class="au-input au-textarea" required maxlength="180" data-message-input placeholder="<%= isRu ? 'Тип оклейки, автомобиль, нужен ли дизайн...' : 'Aplīmēšanas veids...' %>"></textarea>
            <div style="text-align:right;font-size:12px;color:#a099cc;margin-top:4px;"><span data-message-count>0</span> / 180</div>
          </div>
          <div class="form-group">
            <label class="au-label"><%= contact.attachment %></label>
            <label class="upload-dropzone">
              <input type="file" name="attachment" class="upload-dropzone-input" data-file-input accept=".pdf,.jpg,.jpeg,.png,.svg,.ai,.eps,.doc,.docx">
              <span class="upload-dropzone-copy">
                <strong><%= contact.uploadTitle %></strong>
                <small data-file-label><%= contact.uploadHint %></small>
              </span>
            </label>
          </div>
          <button type="submit" class="au-btn-primary au-btn-full">
            <svg viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            <%= servicePage.contactSubmit %>
          </button>
        </form>
      <% } %>
    </div>
  </div>
</section>
