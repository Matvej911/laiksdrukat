<% layout('layout') %>

<div class="admin-page-header">
  <h1><%= it.product && it.product.id ? 'Redigēt produktu' : 'Jauns produkts' %></h1>
  <a href="/admin/products" class="btn btn-outline btn-sm">Atpakal</a>
</div>

<div class="admin-card" style="max-width:860px;">
  <% if (it.error) { %>
    <div class="form-error"><%= it.error %></div>
  <% } %>

  <form action="/admin/products/<%= it.product && it.product.id ? it.product.id + '/edit' : 'new' %>" method="POST" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="<%= it.csrf %>">
    <div class="form-group">
      <label class="form-label">Nosaukums <span class="required">*</span></label>
      <input type="text" name="name" class="form-input" required value="<%= it.product ? it.product.name || '' : '' %>">
    </div>

    <div class="form-group">
      <label class="form-label">Slug (URL) <span class="required">*</span></label>
      <input type="text" name="slug" class="form-input" required value="<%= it.product ? it.product.slug || '' : '' %>" placeholder="piem. colop-55-oval">
    </div>

    <div class="form-group">
      <label class="form-label">Apraksts</label>
      <textarea name="description" class="form-input form-textarea"><%= it.product ? it.product.description || '' : '' %></textarea>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Cena (bez PVN) <span class="required">*</span></label>
        <input type="number" name="price" class="form-input" step="0.01" min="0" required value="<%= it.product ? it.product.price || '' : '' %>">
      </div>
      <div class="form-group">
        <label class="form-label">Pieejamais daudzums</label>
        <input type="number" name="stock" class="form-input" min="0" value="<%= it.product ? it.product.stock || 0 : 0 %>">
      </div>
    </div>

    <div class="form-group">
      <label class="form-label">Kategorija <span class="required">*</span></label>
      <select name="categoryId" class="form-input" required>
        <% for (const cat of it.categories) { %>
          <option value="<%= cat.id %>" <%= it.product && Number(it.product.categoryId) === cat.id ? 'selected' : '' %>>
            <%= cat.name %>
          </option>
        <% } %>
      </select>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Produkta attēla ceļš</label>
        <input type="text" name="image" class="form-input" value="<%= it.product ? it.product.image || '' : '' %>" placeholder="/images/products/zimogi/produkts.webp">
      </div>
      <div class="form-group">
        <label class="form-label">Nospieduma parauga attēla ceļš</label>
        <input type="text" name="imprintImage" class="form-input" value="<%= it.product ? it.product.imprintImage || '' : '' %>" placeholder="/images/products/zimogi/nospiedums.webp">
      </div>
    </div>

    <div class="form-grid">
      <div class="form-group">
        <label class="form-label">Augšupielādēt produkta attēlu</label>
        <input type="file" name="imageUpload" class="form-input" accept=".jpg,.jpeg,.png,.webp,.gif">
      </div>
      <div class="form-group">
        <label class="form-label">Augšupielādēt nospieduma paraugu</label>
        <input type="file" name="imprintImageUpload" class="form-input" accept=".jpg,.jpeg,.png,.webp,.gif">
      </div>
    </div>

    <div class="admin-detail-grid" style="margin:8px 0 20px;">
      <div class="admin-card">
        <div class="admin-meta-label">Pašreizējais produkta attēls</div>
        <% if (it.product && it.product.image) { %>
          <img src="<%= it.product.image %>" alt="<%= it.product.name || 'Produkta attēls' %>" class="admin-image-preview">
        <% } else { %>
          <div class="admin-empty-copy">Attēls vēl nav pievienots.</div>
        <% } %>
      </div>
      <div class="admin-card">
        <div class="admin-meta-label">Pašreizējais nospieduma paraugs</div>
        <% if (it.product && it.product.imprintImage) { %>
          <img src="<%= it.product.imprintImage %>" alt="Nospieduma paraugs" class="admin-image-preview">
        <% } else { %>
          <div class="admin-empty-copy">Nospieduma paraugs vēl nav pievienots.</div>
        <% } %>
      </div>
    </div>

    <div class="form-group" style="display:flex;align-items:center;gap:10px;">
      <input type="checkbox" name="active" id="active" <%= !it.product || it.product.active ? 'checked' : '' %> style="width:16px;height:16px;">
      <label for="active" style="font-size:14px;font-weight:500;cursor:pointer;">Aktīvs (redzams veikalā)</label>
    </div>
    <div class="form-group" style="display:flex;align-items:center;gap:10px;">
      <input type="checkbox" name="featured" id="featured"
        <%= it.product && it.product.featured ? 'checked' : '' %>
        style="width:16px;height:16px;">
      <label for="featured" style="font-size:14px;font-weight:500;cursor:pointer;">
        ⭐ Rādīt kā populāru (homepage slider)
      </label>
    </div>

    <button type="submit" class="btn btn-primary">Saglabat</button>
  </form>
</div>
