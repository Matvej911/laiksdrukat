<% layout('../../partials/layout', { bodyClass: 'page-shop' }) %>
<% const shopPage = it.t.shopPage %>

<!-- HERO -->
<section class="shop-hero">
  <div class="container">
    <%~ include('../../partials/breadcrumbs', { breadcrumbs: it.breadcrumbs }) %>
    <div class="shop-hero-inner">
      <div>
        <span class="shop-eyebrow"><%= shopPage.heroEyebrow %></span>
        <h1><%= shopPage.heroTitle %></h1>
        <p><%= it.site.shop.intro %></p>
      </div>
    </div>
  </div>
</section>

<!-- CATEGORIES -->
<section class="shop-categories-section">
  <div class="container">
    <div class="shop-categories">
      <a href="<%= it.localizedPath('/veikals/') %>" class="shop-cat-pill <%= !it.activeCategory ? 'active' : '' %>">
        <%= shopPage.allProducts %>
        <span class="shop-cat-count"><%= it.allProductsCount || it.totalProducts || it.products.length %></span>
      </a>
      <% for (const categoryInfo of it.site.shop.categories) { %>
        <% const dbCategory = it.categories.find((c) => c.slug === categoryInfo.slug) %>
        <a href="<%= it.localizedPath('/kategorija/' + categoryInfo.slug + '/') %>" class="shop-cat-pill <%= it.activeCategory === categoryInfo.slug ? 'active' : '' %>">
          <%= categoryInfo.title %>
          <span class="shop-cat-count"><%= dbCategory ? dbCategory._count.products : 0 %></span>
        </a>
      <% } %>
    </div>
  </div>
</section>

<!-- TOOLBAR + PRODUCTS -->
<section class="shop-main">
  <div class="container">
    <% const activeListingPath = it.activeCategory ? it.localizedPath('/kategorija/' + it.activeCategory + '/') : it.localizedPath('/veikals/') %>

    <!-- TOOLBAR -->
    <form action="<%= activeListingPath %>" method="GET" class="shop-toolbar-new">
      <div class="shop-search-wrap">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" name="q" value="<%= it.q || '' %>" class="shop-search-input" placeholder="<%= shopPage.searchPlaceholder %>">
      </div>
      <div class="shop-toolbar-right">
        <select name="sort" class="shop-sort-select">
          <option value="name-asc" <%= it.sort === 'name-asc' ? 'selected' : '' %>><%= shopPage.sortName %></option>
          <option value="price-asc" <%= it.sort === 'price-asc' ? 'selected' : '' %>><%= shopPage.sortPriceAsc %></option>
          <option value="price-desc" <%= it.sort === 'price-desc' ? 'selected' : '' %>><%= shopPage.sortPriceDesc %></option>
        </select>
        <button type="submit" class="shop-search-btn"><%= shopPage.searchButton %></button>
        <% if (it.q) { %>
          <a href="<%= activeListingPath %>" class="shop-clear-btn"><%= shopPage.clearButton %></a>
        <% } %>
      </div>
    </form>

    <!-- RESULTS META -->
    <div class="shop-meta">
      <% if (it.q) { %>
        <span><%= shopPage.resultsFor %> "<strong><%= it.q %></strong>"</span>
      <% } %>
      <span class="shop-meta-count"><%= it.totalProducts || it.products.length %> <%= shopPage.productCount %></span>
    </div>

    <!-- EMPTY -->
    <% if (it.products.length === 0) { %>
      <div class="shop-empty">
        <div class="shop-empty-icon">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
        <h2><%= shopPage.emptyTitle %></h2>
        <p><%= shopPage.emptyText %></p>
        <a href="<%= it.localizedPath('/kontakti/') %>" class="btn btn-primary"><%= shopPage.contactButton %></a>
      </div>

    <% } else { %>

      <!-- GRID -->
      <div class="shop-grid">
        <% for (const p of it.products) { %>
          <article class="shop-product-card">
            <a href="<%= it.localizedPath('/veikals/' + p.slug + '/') %>" class="shop-product-link">
              <div class="shop-product-img">
                <% if (p.image) { %>
                  <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" width="800" height="800">
                <% } else { %>
                  <div class="shop-product-placeholder">LD</div>
                <% } %>
              </div>
              <div class="shop-product-info">
                <span class="shop-product-category"><%= p.category.name %></span>
                <h3 class="shop-product-name"><%= p.name %></h3>
                <div class="shop-product-footer">
                  <div class="shop-product-price">
                    <%= Number(p.price).toFixed(2) %> €
                    <span class="shop-product-vat"><%= shopPage.vatLabel %></span>
                  </div>
                </div>
              </div>
            </a>
            <div class="shop-product-actions">
            </div>
          </article>
        <% } %>
      </div>

      <% if (it.pagination && it.pagination.totalPages > 1) { %>
        <nav class="shop-pagination" aria-label="<%= shopPage.paginationLabel %>">
          <% if (it.pagination.prevUrl) { %>
            <a href="<%= it.pagination.prevUrl %>" class="shop-page-link shop-page-link-nav"><%= shopPage.prevPage %></a>
          <% } %>

          <% for (const page of it.pagination.items) { %>
            <a
              href="<%= it.pagination.buildUrl(page) %>"
              class="shop-page-link <%= page === it.pagination.currentPage ? 'active' : '' %>"
              <%= page === it.pagination.currentPage ? 'aria-current="page"' : '' %>
            >
              <%= page %>
            </a>
          <% } %>

          <% if (it.pagination.nextUrl) { %>
            <a href="<%= it.pagination.nextUrl %>" class="shop-page-link shop-page-link-nav"><%= shopPage.nextPage %></a>
          <% } %>
        </nav>
      <% } %>

    <% } %>
  </div>
</section>
