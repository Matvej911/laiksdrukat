<!DOCTYPE html>
<html lang="lv">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.title || it.site.meta.title %></title>
  <meta name="description" content="<%= it.description || it.site.meta.description %>">
  <% if (it.canonicalUrl) { %>
    <link rel="canonical" href="<%= it.canonicalUrl %>">
  <% } %>
  <% if (it.site.meta.favicon && it.site.meta.favicon.icon) { %>
    <link rel="icon" href="<%= it.site.meta.favicon.icon %>">
  <% } %>
  <% if (it.site.meta.favicon && it.site.meta.favicon.svg) { %>
    <link rel="icon" type="image/svg+xml" href="<%= it.site.meta.favicon.svg %>">
  <% } %>
  <% if (it.site.meta.favicon && it.site.meta.favicon.appleTouch) { %>
    <link rel="apple-touch-icon" href="<%= it.site.meta.favicon.appleTouch %>">
  <% } %>
  <link rel="stylesheet" href="/css/main.css?v=<%= it.assetVersion %>">
  <%~ it.extraHead || '' %>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }

    const ldDefaultConsent = {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 500
    };

    gtag('consent', 'default', ldDefaultConsent);

    try {
      const savedConsent = localStorage.getItem('ld_cookie_consent_v1');
      if (savedConsent) {
        const parsed = JSON.parse(savedConsent);
        gtag('consent', 'update', {
          analytics_storage: parsed.analytics ? 'granted' : 'denied',
          ad_storage: parsed.marketing ? 'granted' : 'denied',
          ad_user_data: parsed.marketing ? 'granted' : 'denied',
          ad_personalization: parsed.marketing ? 'granted' : 'denied',
          functionality_storage: parsed.preferences ? 'granted' : 'denied',
          personalization_storage: parsed.preferences ? 'granted' : 'denied',
          security_storage: 'granted'
        });
      }
    } catch (error) {}
  </script>
  <% if (it.isProduction) { %>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-W64BBHWL');
  </script>
  <!-- End Google Tag Manager -->

  
  <% } %>
</head>
<body class="<%= it.bodyClass || '' %>">
<% if (it.isProduction) { %>
<noscript>
  <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W64BBHWL"
  height="0" width="0" style="display:none;visibility:hidden"></iframe>
</noscript>
<% } %>

<header class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <a href="<%= it.site.contact.mapUrl %>" target="_blank" rel="noreferrer"><%= it.site.contact.shortAddress %></a>
      <div class="topbar-links">
        <a href="<%= it.site.contact.phones[0].href %>"><%= it.site.contact.phones[0].label %></a>
        <a href="<%= it.site.contact.emailHref %>"><%= it.site.contact.email %></a>
        <a href="<%= it.site.contact.facebook.url %>" target="_blank" rel="noreferrer"><%= it.site.contact.facebook.label %></a>
      </div>
    </div>
  </div>
  <nav class="nav">
    <div class="container nav-inner">
      <a href="/" class="nav-logo">
        <span>Laiks Drukāt</span>
      </a>

      <button class="hamburger" type="button" aria-expanded="false" aria-controls="nav-menu">
        Izvēlne
      </button>

      <div class="nav-links" id="nav-menu">
        <div class="dropdown">
          <a href="/#pakalpojumi" class="nav-link">Pakalpojumi</a>
          <div class="dropdown-menu">
            <% for (const service of it.site.services) { %>
              <a href="<%= service.path %>"><%= service.menuTitle %></a>
            <% } %>
          </div>
        </div>
        <a href="/veikals/" class="nav-link">Veikals</a>
        <a href="/kontakti/" class="nav-link">Kontakti</a>
       
      </div>

      <a href="/grozs/" class="nav-cart" aria-label="Skatīt grozu">
        <span>Grozs</span>
        <% const cartCount = (it.cart || []).reduce((sum, item) => sum + item.quantity, 0) %>
        <% if (cartCount > 0) { %>
          <span class="nav-cart-count"><%= cartCount %></span>
        <% } %>
      </a>
    </div>
  </nav>
  <div class="header-waves">
    <svg xmlns="http://www.w3.org/2000/svg" height="100%" viewBox="0 0 283.5 27.8" preserveAspectRatio="xMidYMax slice">
      <path fill="<%= it.bodyClass === 'page-home' ? '#3a2a97' : '#5f4bd8' %>" d="M0 0v1.4c.6.7 1.1 1.4 1.4 2 2 3.8 2.2 6.6 1.8 10.8-.3 3.3-2.4 9.4 0 12.3 1.7 2 3.7 1.4 4.6-.9 1.4-3.8-.7-8.2-.6-12 .1-3.7 3.2-5.5 6.9-4.9 4 .6 4.8 4 4.9 7.4.1 1.8-1.1 7 0 8.5.6.8 1.6 1.2 2.4.5 1.4-1.1.1-5.4.1-6.9.1-3.7.3-8.6 4.1-10.5 5-2.5 6.2 1.6 5.4 5.6-.4 1.7-1 9.2 2.9 6.3 1.5-1.1.7-3.5.5-4.9-.4-2.4-.4-4.3 1-6.5.9-1.4 2.4-3.1 4.2-3 2.4.1 2.7 2.2 4 3.7 1.5 1.8 1.8 2.2 3 .1 1.1-1.9 1.2-2.8 3.6-3.3 1.3-.3 4.8-1.4 5.9-.5 1.5 1.1.6 2.8.4 4.3-.2 1.1-.6 4 1.8 3.4 1.7-.4-.3-4.1.6-5.6 1.3-2.2 5.8-1.4 7 .5 1.3 2.1.5 5.8.1 8.1s-1.2 5-.6 7.4c1.3 5.1 4.4.9 4.3-2.4-.1-4.4-2-8.8-.5-13 .9-2.4 4.6-6.6 7.7-4.5 2.7 1.8.5 7.8.2 10.3-.2 1.7-.8 4.6.2 6.2.9 1.4 2 1.5 2.6-.3.5-1.5-.9-4.5-1-6.1-.2-1.7-.4-3.7.2-5.4 1.8-5.6 3.5 2.4 6.3.6 1.4-.9 4.3-9.4 6.1-3.1.6 2.2-1.3 7.8.7 8.9 4.2 2.3 1.5-7.1 2.2-8 3.1-4 4.7 3.8 6.1 4.1 3.1.7 2.8-7.9 8.1-4.5 1.7 1.1 2.9 3.3 3.2 5.2.4 2.2-1 4.5-.6 6.6 1 4.3 4.4 1.5 4.4-1.7 0-2.7-3-8.3 1.4-9.1 4.4-.9 7.3 3.5 7.8 6.9.3 2-1.5 10.9 1.3 11.3 4.1.6-3.2-15.7 4.8-15.8 4.7-.1 2.8 4.1 3.9 6.6 1 2.4 2.1 1 2.3-.8.3-1.9-.9-3.2 1.3-4.3 5.9-2.9 5.9 5.4 5.5 8.5-.3 2-1.7 8.4 2 8.1 6.9-.5-2.8-16.9 4.8-18.7 4.7-1.2 6.1 3.6 6.3 7.1.1 1.7-1.2 8.1.6 9.1 3.5 2 1.9-7 2-8.4.2-4 1.2-9.6 6.4-9.8 4.7-.2 3.2 4.6 2.7 7.5-.4 2.2 1.3 8.6 3.8 4.4 1.1-1.9-.3-4.1-.3-6 0-1.7.4-3.2 1.3-4.6 1-1.6 2.9-3.5 5.1-2.9 2.5.6 2.3 4.1 4.1 4.9 1.9.8 1.6-.9 2.3-2.1 1.2-2.1 2.1-2.1 4.4-2.4 1.4-.2 3.6-1.5 4.9-.5 2.3 1.7-.7 4.4.1 6.5.6 1.5 2.1 1.7 2.8.3.7-1.4-1.1-3.4-.3-4.8 1.4-2.5 6.2-1.2 7.2 1 2.3 4.8-3.3 12-.2 16.3 3 4.1 3.9-2.8 3.8-4.8-.4-4.3-2.1-8.9 0-13.1 1.3-2.5 5.9-5.7 7.9-2.4 2 3.2-1.3 9.8-.8 13.4.5 4.4 3.5 3.3 2.7-.8-.4-1.9-2.4-10 .6-11.1 3.7-1.4 2.8 7.2 6.5.4 2.2-4.1 4.9-3.1 5.2 1.2.1 1.5-.6 3.1-.4 4.6.2 1.9 1.8 3.7 3.3 1.3 1-1.6-2.6-10.4 2.9-7.3 2.6 1.5 1.6 6.5 4.8 2.7 1.3-1.5 1.7-3.6 4-3.7 2.2-.1 4 2.3 4.8 4.1 1.3 2.9-1.5 8.4.9 10.3 4.2 3.3 3-5.5 2.7-6.9-.6-3.9 1-7.2 5.5-5 4.1 2.1 4.3 7.7 4.1 11.6 0 .8-.6 9.5 2.5 5.2 1.2-1.7-.1-7.7.1-9.6.3-2.9 1.2-5.5 4.3-6.2 4.5-1 7.7 1.5 7.4 5.8-.2 3.5-1.8 7.7-.5 11.1 1 2.7 3.6 2.8 5 .2 1.6-3.1 0-8.3-.4-11.6-.4-4.2-.2-7 1.8-10.8 0 0-.1.1-.1.2-.2.4-.3.7-.4.8v.1c-.1.2-.1.2 0 0v-.1l.4-.8c0-.1.1-.1.1-.2.2-.4.5-.8.8-1.2V0H0zM282.7 3.4z"></path>
    </svg>
  </div>
</header>

<main>
  <%~ it.body %>
</main>



<footer class="footer">
  <div class="footer-waves">
    <svg xmlns="http://www.w3.org/2000/svg" height="100%" viewBox="0 0 283.5 27.8" preserveAspectRatio="xMidYMax slice">
      <path class="elementor-shape-fill" d="M0 0v1.4c.6.7 1.1 1.4 1.4 2 2 3.8 2.2 6.6 1.8 10.8-.3 3.3-2.4 9.4 0 12.3 1.7 2 3.7 1.4 4.6-.9 1.4-3.8-.7-8.2-.6-12 .1-3.7 3.2-5.5 6.9-4.9 4 .6 4.8 4 4.9 7.4.1 1.8-1.1 7 0 8.5.6.8 1.6 1.2 2.4.5 1.4-1.1.1-5.4.1-6.9.1-3.7.3-8.6 4.1-10.5 5-2.5 6.2 1.6 5.4 5.6-.4 1.7-1 9.2 2.9 6.3 1.5-1.1.7-3.5.5-4.9-.4-2.4-.4-4.3 1-6.5.9-1.4 2.4-3.1 4.2-3 2.4.1 2.7 2.2 4 3.7 1.5 1.8 1.8 2.2 3 .1 1.1-1.9 1.2-2.8 3.6-3.3 1.3-.3 4.8-1.4 5.9-.5 1.5 1.1.6 2.8.4 4.3-.2 1.1-.6 4 1.8 3.4 1.7-.4-.3-4.1.6-5.6 1.3-2.2 5.8-1.4 7 .5 1.3 2.1.5 5.8.1 8.1s-1.2 5-.6 7.4c1.3 5.1 4.4.9 4.3-2.4-.1-4.4-2-8.8-.5-13 .9-2.4 4.6-6.6 7.7-4.5 2.7 1.8.5 7.8.2 10.3-.2 1.7-.8 4.6.2 6.2.9 1.4 2 1.5 2.6-.3.5-1.5-.9-4.5-1-6.1-.2-1.7-.4-3.7.2-5.4 1.8-5.6 3.5 2.4 6.3.6 1.4-.9 4.3-9.4 6.1-3.1.6 2.2-1.3 7.8.7 8.9 4.2 2.3 1.5-7.1 2.2-8 3.1-4 4.7 3.8 6.1 4.1 3.1.7 2.8-7.9 8.1-4.5 1.7 1.1 2.9 3.3 3.2 5.2.4 2.2-1 4.5-.6 6.6 1 4.3 4.4 1.5 4.4-1.7 0-2.7-3-8.3 1.4-9.1 4.4-.9 7.3 3.5 7.8 6.9.3 2-1.5 10.9 1.3 11.3 4.1.6-3.2-15.7 4.8-15.8 4.7-.1 2.8 4.1 3.9 6.6 1 2.4 2.1 1 2.3-.8.3-1.9-.9-3.2 1.3-4.3 5.9-2.9 5.9 5.4 5.5 8.5-.3 2-1.7 8.4 2 8.1 6.9-.5-2.8-16.9 4.8-18.7 4.7-1.2 6.1 3.6 6.3 7.1.1 1.7-1.2 8.1.6 9.1 3.5 2 1.9-7 2-8.4.2-4 1.2-9.6 6.4-9.8 4.7-.2 3.2 4.6 2.7 7.5-.4 2.2 1.3 8.6 3.8 4.4 1.1-1.9-.3-4.1-.3-6 0-1.7.4-3.2 1.3-4.6 1-1.6 2.9-3.5 5.1-2.9 2.5.6 2.3 4.1 4.1 4.9 1.9.8 1.6-.9 2.3-2.1 1.2-2.1 2.1-2.1 4.4-2.4 1.4-.2 3.6-1.5 4.9-.5 2.3 1.7-.7 4.4.1 6.5.6 1.5 2.1 1.7 2.8.3.7-1.4-1.1-3.4-.3-4.8 1.4-2.5 6.2-1.2 7.2 1 2.3 4.8-3.3 12-.2 16.3 3 4.1 3.9-2.8 3.8-4.8-.4-4.3-2.1-8.9 0-13.1 1.3-2.5 5.9-5.7 7.9-2.4 2 3.2-1.3 9.8-.8 13.4.5 4.4 3.5 3.3 2.7-.8-.4-1.9-2.4-10 .6-11.1 3.7-1.4 2.8 7.2 6.5.4 2.2-4.1 4.9-3.1 5.2 1.2.1 1.5-.6 3.1-.4 4.6.2 1.9 1.8 3.7 3.3 1.3 1-1.6-2.6-10.4 2.9-7.3 2.6 1.5 1.6 6.5 4.8 2.7 1.3-1.5 1.7-3.6 4-3.7 2.2-.1 4 2.3 4.8 4.1 1.3 2.9-1.5 8.4.9 10.3 4.2 3.3 3-5.5 2.7-6.9-.6-3.9 1-7.2 5.5-5 4.1 2.1 4.3 7.7 4.1 11.6 0 .8-.6 9.5 2.5 5.2 1.2-1.7-.1-7.7.1-9.6.3-2.9 1.2-5.5 4.3-6.2 4.5-1 7.7 1.5 7.4 5.8-.2 3.5-1.8 7.7-.5 11.1 1 2.7 3.6 2.8 5 .2 1.6-3.1 0-8.3-.4-11.6-.4-4.2-.2-7 1.8-10.8 0 0-.1.1-.1.2-.2.4-.3.7-.4.8v.1c-.1.2-.1.2 0 0v-.1l.4-.8c0-.1.1-.1.1-.2.2-.4.5-.8.8-1.2V0H0zM282.7 3.4z"></path>
    </svg>
  </div>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <span class="eyebrow">Laiks Drukāt</span>
        <h3>Piedāvājam dažādus drukas un reklāmas risinājumus – no zīmogiem un vizītkartēm līdz banneriem un vides reklāmai.</h3>
        <p>Palīdzam realizēt jūsu idejas ātri un kvalitatīvi.</p>
      </div>

      <div>
        <h4>Pakalpojumi</h4>
        <ul class="footer-links">
          <% for (const service of it.site.services) { %>
            <li><a href="<%= service.path %>"><%= service.menuTitle %></a></li>
          <% } %>
        </ul>
      </div>

      <div>
        <h4>E-veikals</h4>
        <ul class="footer-links">
          <li><a href="/veikals/">Visas preces</a></li>
          <li><a href="/kategorija/zimogi/">Zīmogi</a></li>
          <li><a href="/kategorija/zimogu-tintes">Zīmogu tintes</a></li>
          <li><a href="/grozs/">Grozs</a></li>
        </ul>
      </div>

      <div>
        <h4>Kontakti</h4>
        <ul class="footer-links">
          <li><a href="<%= it.site.contact.mapUrl %>" target="_blank" rel="noreferrer"><%= it.site.contact.address %></a></li>
          <% for (const phone of it.site.contact.phones) { %>
            <li><a href="<%= phone.href %>"><%= phone.label %></a></li>
          <% } %>
          <li><a href="<%= it.site.contact.emailHref %>"><%= it.site.contact.email %></a></li>
          <li><a href="<%= it.site.contact.facebook.url %>" target="_blank" rel="noreferrer"><%= it.site.contact.facebook.label %></a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© <%= it.currentYear %> <%= it.site.company.name %> · <%= it.site.company.legalName %> · Reģ. Nr. <%= it.site.company.registrationNumber %></p>
      <p>Latvija</p>
    </div>
  </div>
</footer>

<div class="cookie-consent" data-cookie-banner hidden>
  <div class="cookie-consent__glow"></div>
  <div class="cookie-consent__eyebrow">Privātums</div>
  <h3>Mēs cienām jūsu privātumu</h3>
  <p>
    Izmantojam sīkfailus, lai nodrošinātu vietnes darbību, analizētu apmeklējumu un uzlabotu pieredzi.
    Vairāk lasiet <a href="/privatuma-politika/">privātuma politikā</a>.
  </p>
  <div class="cookie-consent__actions">
    <button type="button" class="cookie-btn cookie-btn--ghost" data-cookie-action="preferences">Pielāgot</button>
    <button type="button" class="cookie-btn cookie-btn--outline" data-cookie-action="reject">Noraidīt visu</button>
    <button type="button" class="cookie-btn cookie-btn--primary" data-cookie-action="accept">Pieņemt visus</button>
  </div>
</div>

<button type="button" class="cookie-manage-btn" data-cookie-manage hidden>
  Sīkfailu iestatījumi
</button>

<div class="cookie-modal" data-cookie-modal hidden>
  <div class="cookie-modal__backdrop" data-cookie-close></div>
  <div class="cookie-modal__panel" role="dialog" aria-modal="true" aria-labelledby="cookie-modal-title">
    <div class="cookie-modal__header">
      <div>
        <div class="cookie-consent__eyebrow">Sīkfaili</div>
        <h3 id="cookie-modal-title">Pielāgojiet piekrišanas preferences</h3>
      </div>
      <button type="button" class="cookie-modal__close" aria-label="Aizvērt" data-cookie-close>×</button>
    </div>

    <p class="cookie-modal__lead">
      Izvēlieties, kādus sīkfailus drīkstam izmantot. Nepieciešamie sīkfaili vienmēr ir aktīvi,
      pārējās kategorijas varat ieslēgt vai izslēgt.
    </p>

    <div class="cookie-settings">
      <div class="cookie-setting is-locked">
        <div class="cookie-setting__copy">
          <strong>Nepieciešamie</strong>
          <p>Nodrošina vietnes pamatfunkcijas, drošību un groza darbību.</p>
        </div>
        <span class="cookie-setting__badge">Vienmēr aktīvs</span>
      </div>

      <label class="cookie-setting">
        <div class="cookie-setting__copy">
          <strong>Preferences</strong>
          <p>Saglabā jūsu izvēles un palīdz padarīt vietni ērtāku atkārtotos apmeklējumos.</p>
        </div>
        <span class="cookie-switch">
          <input type="checkbox" data-consent-toggle="preferences">
          <span class="cookie-switch__slider"></span>
        </span>
      </label>

      <label class="cookie-setting">
        <div class="cookie-setting__copy">
          <strong>Analītika</strong>
          <p>Ļauj Google Analytics un Google Tag Manager saprast, kā apmeklētāji izmanto vietni.</p>
        </div>
        <span class="cookie-switch">
          <input type="checkbox" data-consent-toggle="analytics">
          <span class="cookie-switch__slider"></span>
        </span>
      </label>

      <label class="cookie-setting">
        <div class="cookie-setting__copy">
          <strong>Mārketings</strong>
          <p>Atļauj reklāmas un atkārtotās mārketinga funkcijas, ja tās vēlāk tiks izmantotas.</p>
        </div>
        <span class="cookie-switch">
          <input type="checkbox" data-consent-toggle="marketing">
          <span class="cookie-switch__slider"></span>
        </span>
      </label>
    </div>

    <div class="cookie-modal__actions">
      <button type="button" class="cookie-btn cookie-btn--outline" data-cookie-action="reject">Noraidīt visu</button>
      <button type="button" class="cookie-btn cookie-btn--ghost" data-cookie-action="save">Saglabāt manas preferences</button>
      <button type="button" class="cookie-btn cookie-btn--primary" data-cookie-action="accept">Pieņemt visus</button>
    </div>
  </div>
</div>

<script src="/js/main.js?v=<%= it.assetVersion %>"></script>
</body>
</html>
