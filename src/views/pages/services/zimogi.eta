<% layout('../../partials/layout', { bodyClass: 'page-zimogi' }) %>
<% const isRu = it.locale === 'ru' %>
<% const servicePage = it.t.servicePage %>

<!-- HERO -->
<section class="zimogi-hero">
  <div class="container">
    <%~ include('../../partials/breadcrumbs', { breadcrumbs: it.breadcrumbs }) %>
    <div class="zimogi-hero-inner">
      <div class="zimogi-hero-copy">
        <span class="zimogi-eyebrow"><%= isRu ? 'Услуга' : 'Pakalpojums' %></span>
        <h1><%= it.service.title %></h1>
        <p><%= it.service.intro %></p>
        <div class="zimogi-hero-actions">
          <a href="<%= it.localizedPath('/kontakti/') %>" class="zimogi-btn-primary"><%= servicePage.requestOffer %></a>
          <a href="<%= it.localizedPath('/kategorija/zimogi/') %>" class="zimogi-btn-outline"><%= isRu ? 'Смотреть магазин' : 'Skatīt veikalu' %></a>
        </div>
        <div class="zimogi-hero-stats">
          <div class="zimogi-stat">
            <span class="zimogi-stat-num">2–4</span>
              <span class="zimogi-stat-label"><%= isRu ? 'рабочих дня' : 'darba dienas' %></span>
          </div>
          <div class="zimogi-stat-divider"></div>
          <div class="zimogi-stat">
            <span class="zimogi-stat-num">100%</span>
              <span class="zimogi-stat-label"><%= isRu ? 'под заказ' : 'pielāgots' %></span>
          </div>
          <div class="zimogi-stat-divider"></div>
          <div class="zimogi-stat">
            <span class="zimogi-stat-num">COLOP</span>
              <span class="zimogi-stat-label"><%= isRu ? 'механизмы' : 'mehānismi' %></span>
          </div>
        </div>
      </div>
      <div class="zimogi-hero-visual">
        <div class="zimogi-hero-img-wrap">
          <img src="/images/web-design/col9p.png" alt="Zīmogi" loading="lazy" width="960" height="720">
        </div>
      
      </div>
    </div>
  </div>
</section>

<!-- WAVES -->
<div class="zimogi-waves">
  <svg xmlns="http://www.w3.org/2000/svg" height="100%" viewBox="0 0 283.5 27.8" preserveAspectRatio="xMidYMax slice">
     <path fill="#3A2A97" d="M0 0v1.4c.6.7 1.1 1.4 1.4 2 2 3.8 2.2 6.6 1.8 10.8-.3 3.3-2.4 9.4 0 12.3 1.7 2 3.7 1.4 4.6-.9 1.4-3.8-.7-8.2-.6-12 .1-3.7 3.2-5.5 6.9-4.9 4 .6 4.8 4 4.9 7.4.1 1.8-1.1 7 0 8.5.6.8 1.6 1.2 2.4.5 1.4-1.1.1-5.4.1-6.9.1-3.7.3-8.6 4.1-10.5 5-2.5 6.2 1.6 5.4 5.6-.4 1.7-1 9.2 2.9 6.3 1.5-1.1.7-3.5.5-4.9-.4-2.4-.4-4.3 1-6.5.9-1.4 2.4-3.1 4.2-3 2.4.1 2.7 2.2 4 3.7 1.5 1.8 1.8 2.2 3 .1 1.1-1.9 1.2-2.8 3.6-3.3 1.3-.3 4.8-1.4 5.9-.5 1.5 1.1.6 2.8.4 4.3-.2 1.1-.6 4 1.8 3.4 1.7-.4-.3-4.1.6-5.6 1.3-2.2 5.8-1.4 7 .5 1.3 2.1.5 5.8.1 8.1s-1.2 5-.6 7.4c1.3 5.1 4.4.9 4.3-2.4-.1-4.4-2-8.8-.5-13 .9-2.4 4.6-6.6 7.7-4.5 2.7 1.8.5 7.8.2 10.3-.2 1.7-.8 4.6.2 6.2.9 1.4 2 1.5 2.6-.3.5-1.5-.9-4.5-1-6.1-.2-1.7-.4-3.7.2-5.4 1.8-5.6 3.5 2.4 6.3.6 1.4-.9 4.3-9.4 6.1-3.1.6 2.2-1.3 7.8.7 8.9 4.2 2.3 1.5-7.1 2.2-8 3.1-4 4.7 3.8 6.1 4.1 3.1.7 2.8-7.9 8.1-4.5 1.7 1.1 2.9 3.3 3.2 5.2.4 2.2-1 4.5-.6 6.6 1 4.3 4.4 1.5 4.4-1.7 0-2.7-3-8.3 1.4-9.1 4.4-.9 7.3 3.5 7.8 6.9.3 2-1.5 10.9 1.3 11.3 4.1.6-3.2-15.7 4.8-15.8 4.7-.1 2.8 4.1 3.9 6.6 1 2.4 2.1 1 2.3-.8.3-1.9-.9-3.2 1.3-4.3 5.9-2.9 5.9 5.4 5.5 8.5-.3 2-1.7 8.4 2 8.1 6.9-.5-2.8-16.9 4.8-18.7 4.7-1.2 6.1 3.6 6.3 7.1.1 1.7-1.2 8.1.6 9.1 3.5 2 1.9-7 2-8.4.2-4 1.2-9.6 6.4-9.8 4.7-.2 3.2 4.6 2.7 7.5-.4 2.2 1.3 8.6 3.8 4.4 1.1-1.9-.3-4.1-.3-6 0-1.7.4-3.2 1.3-4.6 1-1.6 2.9-3.5 5.1-2.9 2.5.6 2.3 4.1 4.1 4.9 1.9.8 1.6-.9 2.3-2.1 1.2-2.1 2.1-2.1 4.4-2.4 1.4-.2 3.6-1.5 4.9-.5 2.3 1.7-.7 4.4.1 6.5.6 1.5 2.1 1.7 2.8.3.7-1.4-1.1-3.4-.3-4.8 1.4-2.5 6.2-1.2 7.2 1 2.3 4.8-3.3 12-.2 16.3 3 4.1 3.9-2.8 3.8-4.8-.4-4.3-2.1-8.9 0-13.1 1.3-2.5 5.9-5.7 7.9-2.4 2 3.2-1.3 9.8-.8 13.4.5 4.4 3.5 3.3 2.7-.8-.4-1.9-2.4-10 .6-11.1 3.7-1.4 2.8 7.2 6.5.4 2.2-4.1 4.9-3.1 5.2 1.2.1 1.5-.6 3.1-.4 4.6.2 1.9 1.8 3.7 3.3 1.3 1-1.6-2.6-10.4 2.9-7.3 2.6 1.5 1.6 6.5 4.8 2.7 1.3-1.5 1.7-3.6 4-3.7 2.2-.1 4 2.3 4.8 4.1 1.3 2.9-1.5 8.4.9 10.3 4.2 3.3 3-5.5 2.7-6.9-.6-3.9 1-7.2 5.5-5 4.1 2.1 4.3 7.7 4.1 11.6 0 .8-.6 9.5 2.5 5.2 1.2-1.7-.1-7.7.1-9.6.3-2.9 1.2-5.5 4.3-6.2 4.5-1 7.7 1.5 7.4 5.8-.2 3.5-1.8 7.7-.5 11.1 1 2.7 3.6 2.8 5 .2 1.6-3.1 0-8.3-.4-11.6-.4-4.2-.2-7 1.8-10.8 0 0-.1.1-.1.2-.2.4-.3.7-.4.8v.1c-.1.2-.1.2 0 0v-.1l.4-.8c0-.1.1-.1.1-.2.2-.4.5-.8.8-1.2V0H0zM282.7 3.4z"></path>
   </svg>
</div>

<!-- FEATURES -->
<section class="zimogi-features">
  <div class="container">
    <div class="zimogi-features-grid">

      <div class="zimogi-feature">
        <div class="zimogi-feature-icon">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3><%= isRu ? 'Срок изготовления' : 'Izgatavošanas laiks' %></h3>
        <p><%= isRu ? 'Изготавливаем штампы за 2–4 рабочих дня после утверждения макета. В срочных случаях возможен ускоренный вариант.' : 'Zīmogus izgatavojam 2–4 darba dienu laikā pēc maketa apstiprināšanas. Steidzamos gadījumos iespējama paātrināta izpilde.' %></p>
      </div>

      <div class="zimogi-feature">
        <div class="zimogi-feature-icon">
          <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <h3><%= isRu ? 'Индивидуальный дизайн' : 'Individuāls dizains' %></h3>
        <p><%= isRu ? 'Каждый штамп разрабатывается под ваши задачи: логотип, реквизиты компании, графические элементы, подписи или любой нужный текст.' : 'Katrs zīmogs tiek izstrādāts pēc Jūsu vajadzībām: logo, uzņēmuma rekvizīti, grafiskie elementi, paraksti vai jebkuri teksti.' %></p>
      </div>

      <div class="zimogi-feature">
        <div class="zimogi-feature-icon">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h3><%= isRu ? 'Качество и механизмы' : 'Kvalitāte un mehānismi' %></h3>
        <p><%= isRu ? 'Используем только качественные механизмы COLOP. Доступны чёрная, синяя, красная, зелёная и фиолетовая краски.' : 'Izgatavojam zīmogus tikai no kvalitatīviem COLOP mehānismiem. Pieejamas tintes krāsas: melna, zila, sarkana, zaļa un violeta.' %></p>
      </div>

      <div class="zimogi-feature">
        <div class="zimogi-feature-icon">
          <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <h3><%= isRu ? 'Получение в Елгаве' : 'Saņemšana Jelgavā' %></h3>
        <p><%= isRu ? 'Заберите штамп в нашем офисе на Asteru iela 16A в Елгаве или закажите доставку в пакомат по всей Латвии.' : 'Saņemiet zīmogu mūsu birojā Asteru iela 16A, Jelgavā vai pasūtiet piegādi uz pakomātu visā Latvijā.' %></p>
      </div>

    </div>
  </div>
</section>

<!-- PROCESS -->
<section class="zimogi-process">
  <div class="container">
    <div class="zimogi-section-header">
      <span class="zimogi-eyebrow-dark"><%= isRu ? 'Как это работает' : 'Kā tas notiek' %></span>
      <h2><%= isRu ? 'Процесс заказа' : 'Pasūtīšanas process' %></h2>
    </div>
    <div class="zimogi-steps">
      <div class="zimogi-step">
        <div class="zimogi-step-num">1</div>
        <h4><%= isRu ? 'Выберите штамп' : 'Izvēlieties zīmogu' %></h4>
        <p><%= isRu ? 'Выберите подходящую модель в нашем интернет-магазине или напишите нам, если нужен индивидуальный вариант.' : 'Izvēlieties vajadzīgo modeli no mūsu e-veikala vai sazinieties, lai apspriestu individuālu risinājumu.' %></p>
      </div>
      <div class="zimogi-step-arrow">→</div>
      <div class="zimogi-step">
        <div class="zimogi-step-num">2</div>
        <h4><%= isRu ? 'Отправьте текст' : 'Nosūtiet tekstu' %></h4>
        <p><%= isRu ? 'Пришлите текст для штампа, логотип или дизайн-файл. Мы подготовим макет и отправим его вам на согласование.' : 'Nosūtiet zīmoga tekstu, logo vai dizaina failu. Sagatavosim maketu un nosūtīsim apstiprināšanai.' %></p>
      </div>
      <div class="zimogi-step-arrow">→</div>
      <div class="zimogi-step">
        <div class="zimogi-step-num">3</div>
        <h4><%= isRu ? 'Подтвердите макет' : 'Apstipriniet maketu' %></h4>
        <p><%= isRu ? 'После утверждения макета запускаем производство. Обычно штамп готов за 2–4 рабочих дня.' : 'Pēc maketa apstiprināšanas uzsākam ražošanu. Zīmogs gatavs 2–4 darba dienās.' %></p>
      </div>
      <div class="zimogi-step-arrow">→</div>
      <div class="zimogi-step">
        <div class="zimogi-step-num">4</div>
        <h4><%= isRu ? 'Получите штамп' : 'Saņemiet zīmogu' %></h4>
        <p><%= isRu ? 'Заберите готовый штамп в офисе или оформите доставку в удобный пакомат.' : 'Saņemiet gatavo zīmogu birojā vai izmantojiet piegādes pakalpojumu uz jebkuru pakomātu.' %></p>
      </div>
    </div>
  </div>
</section>

<!-- PRODUCTS SLIDER -->
<section class="zimogi-products">
  <div class="container">
    <div class="zimogi-section-header">
      <span class="zimogi-eyebrow-dark"><%= isRu ? 'Интернет-магазин' : 'E-veikals' %></span>
      <h2><%= isRu ? 'Популярные товары' : 'Populārākās preces' %></h2>
      <p><%= isRu ? 'Выберите подходящую модель из нашего ассортимента штампов COLOP' : 'Izvēlieties no mūsu plašā COLOP zīmogu klāsta' %></p>
    </div>

    <div class="products-slider-wrapper">
      <button class="slider-btn left" type="button">
        <img src="/images/web-design/angle-left.svg" alt="left" width="24" height="24">
      </button>
      <div class="products-slider-track">
        <div class="products-slider">
          <% for (const p of it.products) { %>
          <article class="product-card">
            <a href="<%= it.localizedPath('/veikals/' + p.slug + '/') %>">
              <div class="product-img">
                <% if (p.image) { %>
                    <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy" width="800" height="800">
                <% } else { %>
                  <div class="product-img-placeholder">LD</div>
                <% } %>
              </div>
              <div class="product-info">
                <div class="product-category"><%= p.category.name %></div>
                <div class="product-name"><%= p.name %></div>
                <div class="product-price">
                  <%= Number(p.price).toFixed(2) %> €
          <span class="product-price-vat"><%= isRu ? '+ НДС' : '+ PVN' %></span>
                </div>
              </div>
            </a>
          </article>
          <% } %>
        </div>
      </div>
      <button class="slider-btn right" type="button">
        <img src="/images/web-design/angle-right.svg" alt="right" width="24" height="24">
      </button>
    </div>

    <div class="zimogi-products-cta">
        <a href="<%= it.localizedPath('/kategorija/zimogi/') %>" class="zimogi-btn-primary"><%= isRu ? 'Смотреть все штампы' : 'Skatīt visus zīmogus' %></a>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="zimogi-faq">
  <div class="container">
    <div class="zimogi-faq-inner">
      <div class="zimogi-faq-sidebar">
      <span class="zimogi-eyebrow-dark">FAQ</span>
      <h2><%= isRu ? 'Часто задаваемые вопросы' : 'Biežāk uzdotie jautājumi' %></h2>
      <p><%= isRu ? 'Не нашли ответ? Напишите нам.' : 'Neatradāt atbildi? Sazinieties ar mums.' %></p>
        <a href="<%= it.localizedPath('/kontakti/') %>" class="zimogi-btn-primary" style="margin-top:20px;display:inline-flex;"><%= servicePage.requestOffer %></a>
      </div>
      <div class="zimogi-faq-list">

        <div class="zimogi-faq-item">
          <button class="zimogi-faq-q" onclick="toggleFaq(this)">
            <%= isRu ? 'Как быстро можно изготовить штамп?' : 'Cik ātri var izgatavot zīmogu?' %>
            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="zimogi-faq-a">
            <p><%= isRu ? 'Обычно за 2–4 рабочих дня после утверждения макета. Если нужно срочно, напишите нам — подскажем возможный срок.' : 'Parasti 2–4 darba dienu laikā pēc maketa apstiprināšanas. Steidzamos gadījumos iespējama ātrāka izpilde — sazinieties ar mums.' %></p>
          </div>
        </div>

        <div class="zimogi-faq-item">
          <button class="zimogi-faq-q" onclick="toggleFaq(this)">
            <%= isRu ? 'Можно ли заказать только резиновую часть?' : 'Vai var pasūtīt tikai gumijas daļu?' %>
            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="zimogi-faq-a">
            <p><%= isRu ? 'Да, можно заменить только резиновую часть существующего механизма. Напишите нам и укажите модель штампа.' : 'Jā, iespējama arī tikai gumijas daļas atjaunošana esošam mehānismam. Sazinieties ar mums, norādot zīmoga modeli.' %></p>
          </div>
        </div>

        <div class="zimogi-faq-item">
          <button class="zimogi-faq-q" onclick="toggleFaq(this)">
            <%= isRu ? 'Нужен ли регистрационный номер компании?' : 'Vai nepieciešams uzņēmuma reģistrācijas numurs?' %>
            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="zimogi-faq-a">
            <p><%= isRu ? 'Да, для официальных штампов компании нужны реквизиты. Для частных лиц регистрационный номер не требуется.' : 'Jā, oficiāliem uzņēmumu zīmogiem jānorāda rekvizīti. Privātpersonām reģistrācijas numurs nav nepieciešams.' %></p>
          </div>
        </div>

        <div class="zimogi-faq-item">
          <button class="zimogi-faq-q" onclick="toggleFaq(this)">
            <%= isRu ? 'Какие цвета чернил доступны?' : 'Kādas tintes krāsas ir pieejamas?' %>
            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="zimogi-faq-a">
            <p><%= isRu ? 'Доступны пять цветов: чёрный, синий, красный, зелёный и фиолетовый. Все краски COLOP качественные и долговечные.' : 'Piedāvājam piecas krāsas: melna, zila, sarkana, zaļa un violeta. Visas COLOP tintes ir augstas kvalitātes un ilgmūžīgas.' %></p>
          </div>
        </div>

        <div class="zimogi-faq-item">
          <button class="zimogi-faq-q" onclick="toggleFaq(this)">
            <%= isRu ? 'Можно ли заказать штамп с логотипом?' : 'Vai var pasūtīt zīmogu ar logo?' %>
            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="zimogi-faq-a">
            <p><%= isRu ? 'Да, в макет можно включить логотип, графические элементы и иллюстрации. Отправьте файл в формате PNG, SVG или AI.' : 'Jā, logo, grafiskos elementus un ilustrācijas var iekļaut zīmoga dizainā. Nosūtiet failu PNG, SVG vai AI formātā.' %></p>
          </div>
        </div>

        <div class="zimogi-faq-item">
          <button class="zimogi-faq-q" onclick="toggleFaq(this)">
            <%= isRu ? 'Как проходит доставка?' : 'Kā notiek piegāde?' %>
            <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="zimogi-faq-a">
            <p><%= isRu ? 'Штамп можно забрать в нашем офисе на Asteru iela 16A в Елгаве или оформить доставку в пакомат Omniva за дополнительную плату.' : 'Zīmogu var saņemt mūsu birojā Asteru iela 16A, Jelgavā, vai piegādāt uz Omniva pakomātu par papildu maksu.' %></p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="zimogi-cta">
  <div class="container">
    <div class="zimogi-cta-inner">
      <div>
        <h2><%= isRu ? 'Готовы заказать штамп?' : 'Gatavi pasūtīt zīmogu?' %></h2>
        <p><%= isRu ? 'Свяжитесь с нами или выберите модель в магазине и оформите заказ онлайн.' : 'Sazinieties ar mums vai izvēlieties modeli no veikala un aizpildiet pasūtījumu tiešsaistē.' %></p>
      </div>
      <div class="zimogi-cta-actions">
        <a href="tel:<%= it.site.contact.phones[0].href %>" class="zimogi-cta-pill">
          <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.21h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6 6l.86-.86a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <%= it.site.contact.phones[0].label %>
        </a>
        <a href="<%= it.localizedPath('/kontakti/') %>" class="zimogi-btn-primary"><%= servicePage.contactSubmit %></a>
        <a href="<%= it.localizedPath('/kategorija/zimogi/') %>" class="zimogi-btn-outline"><%= isRu ? 'Интернет-магазин' : 'E-veikals' %></a>
      </div>
    </div>
  </div>
</section>

<script>
function toggleFaq(btn) {
  const item = btn.closest('.zimogi-faq-item')
  const isOpen = item.classList.contains('open')
  document.querySelectorAll('.zimogi-faq-item').forEach(i => i.classList.remove('open'))
  if (!isOpen) item.classList.add('open')
}
</script>
