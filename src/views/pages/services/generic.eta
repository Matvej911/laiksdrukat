<% layout('../../partials/layout', { bodyClass: 'page-service-generic' }) %>
<% const page = it.t.servicePage %>

<section class="page-hero">
  <div class="container">
    <%~ include('../../partials/breadcrumbs', { breadcrumbs: it.breadcrumbs }) %>

    <div class="service-hero">
      <div class="service-copy">
        <span class="eyebrow"><%= page.heroEyebrow %></span>
        <h1><%= it.service.title %></h1>
        <p><%= it.service.intro %></p>
        <div class="hero-actions">
          <a href="<%= it.localizedPath('/kontakti/') %>" class="btn btn-primary"><%= page.requestOffer %></a>
          <a href="/veikals/" class="btn btn-outline"><%= page.viewShop %></a>
        </div>
      </div>

      <div class="service-media">
        <img src="<%= it.service.heroImage %>" alt="<%= it.service.heroAlt %>" loading="lazy" width="1200" height="900">
      </div>
    </div>

    <% if (it.service.highlights && it.service.highlights.length) { %>
      <div class="highlight-grid">
        <% for (const highlight of it.service.highlights) { %>
          <div class="highlight-card">
            <strong><%= highlight.value %></strong>
            <span><%= highlight.label %></span>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading section-heading-left">
      <span class="eyebrow"><%= page.offeringsEyebrow %></span>
      <h2><%= page.offeringsTitle %></h2>
      <p><%= it.service.teaser %></p>
    </div>

    <% if (it.service.offerings && it.service.offerings.length) { %>
      <div class="detail-grid">
        <% for (const item of it.service.offerings) { %>
          <article class="detail-card">
            <h3><%= item.title %></h3>
            <p><%= item.text %></p>
          </article>
        <% } %>
      </div>
    <% } %>
  </div>
</section>

<section class="section section-muted">
  <div class="container service-columns">
    <div class="info-panel">
      <span class="eyebrow"><%= page.detailsEyebrow %></span>
      <h2><%= page.detailsTitle %></h2>
      <ul class="info-list">
        <% for (const detail of (it.service.details || [])) { %>
          <li><%= detail %></li>
        <% } %>
      </ul>
    </div>

    <div class="info-panel">
      <span class="eyebrow"><%= page.pricingEyebrow %></span>
      <h2><%= page.pricingTitle %></h2>
      <div class="pricing-grid">
        <% for (const item of (it.service.pricing || [])) { %>
          <article class="price-card">
            <h3><%= item.title %></h3>
            <p><%= item.text %></p>
          </article>
        <% } %>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading section-heading-left">
      <span class="eyebrow"><%= page.processEyebrow %></span>
      <h2><%= page.processTitle %></h2>
    </div>

    <div class="detail-grid">
      <% for (const item of page.process) { %>
        <article class="detail-card">
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
      <% } %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading section-heading-left">
      <span class="eyebrow"><%= page.galleryEyebrow %></span>
      <h2><%= page.galleryTitle %></h2>
      <p><%= page.galleryText %></p>
    </div>

    <div class="gallery-grid">
      <% for (const image of (it.service.gallery || [])) { %>
        <div class="gallery-card">
          <img src="<%= image.image %>" alt="<%= image.alt || it.service.title %>" loading="lazy" width="1200" height="900">
        </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section section-dark">
  <div class="container contact-band">
    <div>
      <span class="eyebrow"><%= page.contactEyebrow %></span>
      <h2><%= page.contactTitle %></h2>
      <p><%= page.contactText %></p>
    </div>
    <div class="contact-points">
      <a href="<%= it.site.contact.phones[0].href %>" class="contact-pill"><%= it.site.contact.phones[0].label %></a>
      <a href="<%= it.site.contact.emailHref %>" class="contact-pill"><%= it.site.contact.email %></a>
      <a href="<%= it.localizedPath('/kontakti/') %>" class="btn btn-primary"><%= page.requestOffer %></a>
    </div>
  </div>
</section>

<section class="contact-main-section">
  <div class="container contact-main-grid">
    <div class="contact-form-block contact-form-block--full">
      <span class="contact-eyebrow"><%= it.t.contact.formEyebrow %></span>
      <h2><%= page.contactTitle %></h2>
      <p><%= page.contactHint %></p>

      <% if (it.success) { %>
        <div class="contact-alert contact-alert-success">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#255f31" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <%= page.contactSuccess %>
        </div>
      <% } %>
      <% if (it.error) { %>
        <div class="contact-alert contact-alert-error">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#912b2b" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= it.error %>
        </div>
      <% } %>

      <form action="<%= it.localizedPath('/pakalpojumi-kontakts') %>" method="POST" enctype="multipart/form-data" class="contact-form">
        <input type="hidden" name="_csrf" value="<%= it.csrf %>">
        <input type="hidden" name="returnTo" value="<%= it.localizedPath(it.service.path) %>">

        <div class="contact-form-row">
          <div class="form-group">
            <label class="form-label"><%= it.t.contact.name %> <span class="required">*</span></label>
            <input type="text" name="name" class="form-input" required>
          </div>
          <div class="form-group">
            <label class="form-label"><%= it.t.contact.email %> <span class="required">*</span></label>
            <input type="email" name="email" class="form-input" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label"><%= it.t.contact.phone %></label>
          <input type="tel" name="phone" class="form-input">
        </div>

        <div class="form-group">
          <div class="form-label-row">
            <label class="form-label"><%= it.t.contact.message %> <span class="required">*</span></label>
            <span class="character-count"><span data-message-count>0</span> / 180</span>
          </div>
          <textarea
            name="message"
            class="form-input form-textarea contact-message-input"
            maxlength="180"
            required
            data-message-input
          ></textarea>
        </div>

        <div class="form-group">
          <label class="form-label"><%= it.t.contact.attachment %></label>
          <label class="upload-dropzone">
            <input type="file" name="attachment" class="upload-dropzone-input" data-file-input accept=".pdf,.jpg,.jpeg,.png,.svg,.ai,.eps,.doc,.docx">
            <span class="upload-dropzone-copy">
              <strong><%= it.t.contact.uploadTitle %></strong>
              <small data-file-label><%= it.t.contact.uploadHint %></small>
            </span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-full"><%= page.contactSubmit %></button>
      </form>
    </div>
  </div>
</section>
