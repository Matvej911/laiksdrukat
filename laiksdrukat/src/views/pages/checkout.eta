<% layout('../partials/layout', { bodyClass: 'page-checkout' }) %>
<% const formData = it.formData || {} %>
<% const totalVat = Number(it.total) * 0.21 %>
<% const totalWithVat = Number(it.total) + totalVat %>

<!-- HERO -->
<section class="checkout-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Sākums</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/grozs">Grozs</a>
      <span class="breadcrumb-sep">/</span>
      <span>Pasūtījums</span>
    </div>
    <div class="checkout-hero-inner">
      <div class="checkout-hero-copy">
        <h1>Noformēt pasūtījumu</h1>
        <p>Aizpildiet savus datus un mēs sazināsimies par apstiprināšanu.</p>
      </div>
      <div class="checkout-steps">
        <div class="checkout-step done">
          <div class="checkout-step-dot">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <span>Grozs</span>
        </div>
        <div class="checkout-step-line"></div>
        <div class="checkout-step active">
          <div class="checkout-step-dot">2</div>
          <span>Pasūtījums</span>
        </div>
        <div class="checkout-step-line"></div>
        <div class="checkout-step">
          <div class="checkout-step-dot">3</div>
          <span>Apstiprinājums</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MAIN -->
<section class="checkout-main">
  <div class="container checkout-grid">

    <!-- FORM -->
    <div class="checkout-form-wrap">

      <% if (it.error) { %>
        <div class="checkout-error">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <%= it.error %>
        </div>
      <% } %>

      <form action="/checkout" method="POST" class="checkout-form-new">

        <!-- CONTACT -->
        <div class="checkout-form-section">
          <div class="checkout-form-section-header">
            <div class="checkout-form-section-num">1</div>
            <h2>Kontaktinformācija</h2>
          </div>
          <div class="checkout-fields">
            <div class="checkout-field-row">
              <div class="form-group">
                <label class="co-label">Vārds <span class="required">*</span></label>
                <input type="text" name="firstName" class="co-input" required value="<%= formData.firstName || '' %>" placeholder="Jānis">
              </div>
              <div class="form-group">
                <label class="co-label">Uzvārds <span class="required">*</span></label>
                <input type="text" name="lastName" class="co-input" required value="<%= formData.lastName || '' %>" placeholder="Bērziņš">
              </div>
            </div>
            <div class="form-group">
              <label class="co-label">E-pasta adrese <span class="required">*</span></label>
              <input type="email" name="email" class="co-input" required value="<%= formData.email || '' %>" placeholder="janis@example.lv">
            </div>
            <div class="form-group">
              <label class="co-label">Tālrunis</label>
              <input type="tel" name="phone" class="co-input" value="<%= formData.phone || '' %>" placeholder="+371 2X XXX XXX">
            </div>
          </div>
        </div>

        <!-- DELIVERY METHOD -->
        <div class="checkout-form-section">
          <div class="checkout-form-section-header">
            <div class="checkout-form-section-num">2</div>
            <h2>Piegādes veids</h2>
          </div>
          <div class="checkout-fields">

            <label class="co-payment-option">
              <input type="radio" name="deliveryType" value="pickup" 
                <%= !formData.deliveryType || formData.deliveryType === 'pickup' ? 'checked' : '' %>
                onchange="toggleDelivery(this.value)">
              <div class="co-payment-card">
                <div class="co-payment-icon">
                  <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div>
                  <strong>Saņemt birojā — bezmaksas</strong>
                  <span>Asteru iela 16A, Jelgava · Pirmdiena–Ceturtdiena 8:00–17:00, Piektdiena 8:00–16:00</span>
                </div>
                <div class="co-payment-check">
                  <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
              </div>
            </label>

            <label class="co-payment-option">
              <input type="radio" name="deliveryType" value="omniva"
                <%= formData.deliveryType === 'omniva' ? 'checked' : '' %>
                onchange="toggleDelivery(this.value)">
              <div class="co-payment-card">
                <div class="co-payment-icon">
                  <svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                </div>
                <div>
                  <strong>Omniva pakomāts <span class="co-delivery-price">+ 3,50 €</span></strong>
                  <span>Piegāde uz jebkuru Omniva pakomātu Latvijā.</span>
                </div>
                <div class="co-payment-check">
                  <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
              </div>
            </label>

          </div>
        </div>

        <!-- ADDRESS — shown only for omniva -->
        <div class="checkout-form-section" id="addressSection" 
          style="<%= formData.deliveryType === 'omniva' ? '' : 'display:none' %>">
          <div class="checkout-form-section-header">
            <div class="checkout-form-section-num">3</div>
            <h2>Piegādes adrese</h2>
          </div>
          <div class="checkout-fields">
            <div class="form-group">
              <label class="co-label">Valsts</label>
              <select name="country" class="co-input co-select">
                <option value="Latvija">🇱🇻 Latvija</option>
              </select>
            </div>
            <div class="form-group">
              <label class="co-label">Omniva pakomāta adrese <span class="required">*</span></label>
              <input type="text" name="address" class="co-input" 
                placeholder="Piem. Brīvības iela 1, Rīga" 
                value="<%= formData.address || '' %>">
            </div>
            <div class="checkout-field-row">
              <div class="form-group">
                <label class="co-label">Pilsēta <span class="required">*</span></label>
                <input type="text" name="city" class="co-input" 
                  value="<%= formData.city || '' %>" placeholder="Rīga">
              </div>
              <div class="form-group">
                <label class="co-label">Pasta indekss <span class="required">*</span></label>
                <input type="text" name="zip" class="co-input" 
                  value="<%= formData.zip || '' %>" placeholder="LV-1001">
              </div>
            </div>
          </div>
        </div>

        <!-- PAYMENT -->
        <div class="checkout-form-section">
          <div class="checkout-form-section-header">
            <div class="checkout-form-section-num">3</div>
            <h2>Maksājuma veids</h2>
          </div>
          <div class="checkout-fields">
            <label class="co-payment-option">
              <input type="radio" name="paymentMethod" value="Tiešais bankas pārskaitījums" <%= !formData.paymentMethod || formData.paymentMethod === 'Tiešais bankas pārskaitījums' ? 'checked' : '' %>>
              <div class="co-payment-card">
                <div class="co-payment-icon">
                  <svg viewBox="0 0 24 24"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                </div>
                <div>
                  <strong>Bankas pārskaitījums</strong>
                  <span>Pēc pasūtījuma apstiprināšanas nosūtīsim rekvizītus.</span>
                </div>
                <div class="co-payment-check">
                  <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
              </div>
            </label>

            <label class="co-payment-option">
              <input type="radio" name="paymentMethod" value="Skaidrā naudā pēc piegādes" <%= formData.paymentMethod === 'Skaidrā naudā pēc piegādes' ? 'checked' : '' %>>
              <div class="co-payment-card">
                <div class="co-payment-icon">
                  <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <div>
                  <strong>Skaidra nauda</strong>
                  <span>Norēķins pie saņemšanas vai pēc iepriekšējas saskaņošanas.</span>
                </div>
                <div class="co-payment-check">
                  <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
              </div>
            </label>
          </div>
        </div>

        <button type="submit" class="co-submit-btn">
          <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Veikt pasūtījumu
        </button>

        <p class="co-submit-note">Nospiežot pogu, jūs piekrītat mūsu noteikumiem. Pasūtījums tiks apstiprināts pa e-pastu.</p>

      </form>
    </div>

    <!-- SUMMARY -->
    <aside class="co-summary">
      <div class="co-summary-card">
        <h3>Jūsu pasūtījums</h3>

        <div class="co-item-list">
          <% for (const item of it.cart) { %>
            <div class="co-item">
              <div class="co-item-img">
                <% if (item.image) { %>
                  <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
                <% } else { %>
                  <div class="co-item-placeholder">LD</div>
                <% } %>
              </div>
              <div class="co-item-info">
                <div class="co-item-name"><%= item.name %></div>
                <% if (item.options && Object.keys(item.options).length > 0) { %>
                  <div class="co-item-options">
                    <% for (const [key, value] of Object.entries(item.options)) { %>
                      <% if (key !== 'Faila saite') { %>
                        <span><%= key %>: <%= value %></span>
                      <% } %>
                    <% } %>
                  </div>
                <% } %>
                <div class="co-item-qty">× <%= item.quantity %></div>
              </div>
              <div class="co-item-price"><%= (Number(item.price) * item.quantity * 1.21).toFixed(2) %> €</div>
            </div>
          <% } %>

          <div class="co-item" id="co-delivery-item" style="display:none">
            <div class="co-item-img" style="display:flex;align-items:center;justify-content:center;background:#f4f2fd;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#5f4bd8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            </div>
            <div class="co-item-info">
              <div class="co-item-name">Piegāde — Omniva pakomāts</div>
              <div class="co-item-qty">Latvija</div>
            </div>
            <div class="co-item-price">3,50 €</div>
          </div>
        </div>
        


        <div class="co-totals">
          <div class="co-total-row">
            <span>Bez PVN</span>
            <span id="co-subtotal-display"><%= Number(it.total).toFixed(2) %> €</span>
          </div>
          <div class="co-total-row">
            <span>PVN 21%</span>
            <span id="co-vat-display"><%= (Number(it.total) * 0.21).toFixed(2) %> €</span>
          </div>
          <div class="co-total-row" id="co-delivery-row" style="display:none">
            <span>Piegāde (Omniva)</span>
            <span>+ 3,50 €</span>
          </div>
          <div class="co-total-final">
            <span>Kopā</span>
            <span id="co-total-display"><%= (Number(it.total) * 1.21).toFixed(2) %> €</span>
          </div>
        </div>

        <div class="co-trust-badges">
          <div class="co-trust-badge">
            <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Droši
          </div>
          <div class="co-trust-badge">
            <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Jelgava, LV
          </div>
          <div class="co-trust-badge">
            <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
            Garantija
          </div>
        </div>
      </div>

      <a href="/grozs" class="co-back-link">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        Atpakaļ uz grozu
      </a>
    </aside>

  </div>
</section>


<script>
function toggleDelivery(value) {
  console.log('toggleDelivery called with:', value)
  console.log('addressSection:', document.getElementById('addressSection'))
  console.log('deliveryItem:', document.getElementById('co-delivery-item'))
  var addressSection = document.getElementById('addressSection')
  var addressInputs = addressSection.querySelectorAll('input, select')

  if (value === 'omniva') {
    addressSection.style.display = 'block'
    addressInputs.forEach(function(input) {
      if (['address','city','zip'].includes(input.name)) input.required = true
    })
  } else {
    addressSection.style.display = 'none'
    addressInputs.forEach(function(input) { input.required = false })
  }

  var basePreVat = <%= Number(it.total).toFixed(2) %>;
  var deliveryFee = 3.50
  var extra = value === 'omniva' ? deliveryFee : 0
  var vat = basePreVat * 0.21
  var newTotal = basePreVat + vat + extra

  var subtotalEl = document.getElementById('co-subtotal-display')
  var vatEl = document.getElementById('co-vat-display')
  var totalEl = document.getElementById('co-total-display')
  var deliveryRow = document.getElementById('co-delivery-row')
  var deliveryItem = document.getElementById('co-delivery-item')

  if (subtotalEl) subtotalEl.textContent = basePreVat.toFixed(2) + ' €'
  if (vatEl) vatEl.textContent = vat.toFixed(2) + ' €'
  if (totalEl) totalEl.textContent = newTotal.toFixed(2) + ' €'
  if (deliveryRow) deliveryRow.style.display = value === 'omniva' ? 'flex' : 'none'
  if (deliveryItem) deliveryItem.style.display = value === 'omniva' ? 'flex' : 'none'
}

document.addEventListener('DOMContentLoaded', function() {
  console.log('DOM loaded')
  console.log('payment options found:', document.querySelectorAll('.co-payment-option').length)
  console.log('delivery item found:', document.getElementById('co-delivery-item'))
  console.log('selected radio:', document.querySelector('input[name="deliveryType"]:checked'))

  document.querySelectorAll('.co-payment-option').forEach(function(label) {
    console.log('attaching click to label:', label)
    label.addEventListener('click', function() {
      var radio = label.querySelector('input[name="deliveryType"]')
      console.log('label clicked, radio:', radio, 'value:', radio ? radio.value : 'none')
      if (radio) setTimeout(function() { toggleDelivery(radio.value) }, 0)
    })
  })

  var selected = document.querySelector('input[name="deliveryType"]:checked')
  if (selected) toggleDelivery(selected.value)
})
</script>