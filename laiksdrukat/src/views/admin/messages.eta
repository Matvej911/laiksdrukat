<% layout('layout') %>

<div class="admin-page-header">
  <h1>Kontaktu zinas</h1>
</div>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Datums</th>
        <th>Vards</th>
        <th>E-pasts</th>
        <th>Talrunis</th>
        <th>Zina</th>
        <th>Pielikums</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% if (it.messages.length === 0) { %>
        <tr>
          <td colspan="7" style="color:var(--gray-400);">Vel nav saņemta neviena kontaktforma.</td>
        </tr>
      <% } %>
      <% for (const message of it.messages) { %>
        <tr>
          <td style="font-size:13px;color:var(--gray-400);"><%= new Date(message.createdAt).toLocaleString('lv-LV') %></td>
          <td style="font-weight:700;"><%= message.name %></td>
          <td><%= message.email %></td>
          <td><%= message.phone || '-' %></td>
          <td>
            <% if (message.message.length > 80) { %>
              <%= message.message.slice(0, 80) %>...
            <% } else { %>
              <%= message.message %>
            <% } %>
          </td>
          <td>
            <% if (message.attachment) { %>
              <a href="<%= message.attachment.url %>" target="_blank" rel="noreferrer">Atvērt failu</a>
            <% } else { %>
              -
            <% } %>
          </td>
          <td><a href="/admin/messages/<%= message.id %>" class="btn btn-sm btn-outline">Skatit</a></td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
