
<%~ include('layout', { ...it, body: `

<section class="page-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Sākums</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/#pakalpojumi">Pakalpojumi</a>
      <span class="breadcrumb-sep">/</span>
      <span>${it.service.title}</span>
    </div>

    <div class="service-hero">
      <div class="service-copy">
        <span class="eyebrow">Pakalpojums</span>
        <h1>${it.service.title}</h1>
        <p>${it.service.intro}</p>
        <div class="hero-actions">
          <a href="/kontakti" class="btn btn-primary">Pieprasīt piedāvājumu</a>
          <a href="/veikals" class="btn btn-outline">Skatīt e-veikalu</a>
        </div>
      </div>

      <div class="service-media">
        <img src="${it.service.heroImage}" alt="${it.service.heroAlt}" loading="lazy">
      </div>
    </div>

    <div class="highlight-grid">
      <% for (const highlight of it.service.highlights) { %>
        <div class="highlight-card">
          <strong><%= highlight.value %></strong>
          <span><%= highlight.label %></span>
        </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading section-heading-left">
      <span class="eyebrow">Ko varam izdarīt</span>
      <h2>Risinājumi šim pakalpojumam</h2>
      <p>${it.service.teaser}</p>
    </div>

    <div class="detail-grid">
      <% for (const item of it.service.offerings) { %>
        <article class="detail-card">
          <h3><%= item.title %></h3>
          <p><%= item.text %></p>
        </article>
      <% } %>
    </div>
  </div>
</section>

<section class="section section-muted">
  <div class="container service-columns">
    <div class="info-panel">
      <span class="eyebrow">Svarīgi zināt</span>
      <h2>Darba nianses un ieguvumi</h2>
      <ul class="info-list">
        <% for (const detail of it.service.details) { %>
          <li><%= detail %></li>
        <% } %>
      </ul>
    </div>

    <div class="info-panel">
      <span class="eyebrow">Cenas un budžets</span>
      <h2>Orientējoša informācija</h2>
      <div class="pricing-grid">
        <% for (const item of it.service.pricing) { %>
          <article class="price-card">
            <h3><%= item.title %></h3>
            <p><%= item.text %></p>
          </article>
        <% } %>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-heading section-heading-left">
      <span class="eyebrow">Darbu piemēri</span>
      <h2>Saistīts portfolio</h2>
      <p>Daļa no attēliem izmantota no pašreizējās vietnes, lai Fastify versija saglabātu pazīstamu vizuālo sajūtu.</p>
    </div>

    <div class="gallery-grid">
      <% for (const image of it.service.gallery) { %>
        <div class="gallery-card">
          <img src="<%= image %>" alt="<%= it.service.title %>" loading="lazy">
        </div>
      <% } %>
    </div>
  </div>
</section>

<section class="section section-dark">
  <div class="container contact-band">
    <div>
      <span class="eyebrow">Nākamais solis</span>
      <h2>Pastāstiet, kas vajadzīgs, un saliksim piedāvājumu</h2>
      <p>Jo vairāk detaļu par izmēru, tirāžu, materiālu vai termiņu, jo ātrāk varam sagatavot precīzu atbildi.</p>
    </div>
    <div class="contact-points">
      <a href="${it.site.contact.phones[0].href}" class="contact-pill">${it.site.contact.phones[0].label}</a>
      <a href="${it.site.contact.emailHref}" class="contact-pill">${it.site.contact.email}</a>
      <a href="/kontakti" class="btn btn-primary">Atvērt kontaktus</a>
    </div>
  </div>
</section>

` }) %>
