<% layout('../../partials/layout') %>

<section class="page-hero page-hero-compact">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Sākums</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/veikals">Veikals</a>
      <span class="breadcrumb-sep">/</span>
      <a href="/veikals/kategorija/<%= it.product.category.slug %>"><%= it.product.category.name %></a>
      <span class="breadcrumb-sep">/</span>
      <span><%= it.product.name %></span>
    </div>
  </div>
</section>

<section class="section">
  <div class="container product-layout">
    <div class="product-stage">
      <% if (it.product.image) { %>
        <img src="<%= it.product.image %>" alt="<%= it.product.name %>" loading="lazy">
      <% } else { %>
        <div class="product-stage-placeholder">LD</div>
      <% } %>
    </div>

    <div class="product-summary">
      <div class="product-category"><%= it.product.category.name %></div>
      <h1><%= it.product.name %></h1>
      <div class="product-price-large"><%= Number(it.product.price).toFixed(2) %> €</div>
      <p class="product-note">+ PVN</p>

      <% if (it.product.stock > 0) { %>
        <div class="stock-pill">Pieejams noliktavā: <%= it.product.stock %> gab.</div>
        <% if (it.isStampProduct) { %>
          <form action="/grozs/add" method="POST" enctype="multipart/form-data" class="product-config-form">
            <input type="hidden" name="productId" value="<%= it.product.id %>">

            <div class="form-group">
              <label class="form-label">Nospieduma tintes krāsa: <span class="required">*</span></label>
              <select name="inkColor" class="form-input" required>
                <option value="Melna">Melna</option>
                <option value="Zila">Zila</option>
                <option value="Sarkana">Sarkana</option>
                <option value="Zaļa">Zaļa</option>
                <option value="Violeta">Violeta</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label">Preces saņemšana: <span class="required">*</span></label>
              <select name="deliveryMethod" class="form-input" data-delivery-method required>
                <option value="Birojā">Birojā</option>
                <option value="Pakomāts">Pakomāts + 3,00 €</option>
              </select>
            </div>

            <div class="form-group delivery-address-group" data-delivery-address-group hidden>
              <label class="form-label">Adrese: <span class="required">*</span></label>
              <input
                type="text"
                name="deliveryAddress"
                class="form-input"
                data-delivery-address-input
                placeholder="Ievadiet Omniva pakomāta adresi (stingrs formāts nav obligāts)"
              >
            </div>

            <div class="form-group">
              <label class="form-label">Teksts zīmogam</label>
              <textarea name="stampText" class="form-input form-textarea" placeholder="Pievienot tekstu zīmogam (rakstat brīvā veidā) vai pievienojiet failu zemāk."></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Faila augšupielāde</label>
              <input type="file" name="stampFile" class="form-input" accept=".pdf,.jpg,.jpeg,.png,.svg,.ai,.eps,.doc,.docx">
            </div>

            <div class="product-buy-row">
              <div class="form-group">
                <label class="form-label"><%= it.product.name %> daudzums</label>
                <input type="number" name="quantity" value="1" min="1" max="<%= it.product.stock %>" class="qty-input">
              </div>
              <button type="submit" class="btn btn-primary">Pievienot grozam</button>
            </div>
          </form>
        <% } else { %>
          <form action="/grozs/add" method="POST" class="product-buy-form">
            <input type="hidden" name="productId" value="<%= it.product.id %>">
            <input type="number" name="quantity" value="1" min="1" max="<%= it.product.stock %>" class="qty-input">
            <button type="submit" class="btn btn-primary">Pievienot grozam</button>
          </form>
        <% } %>
      <% } else { %>
        <div class="note-card">
          <h3>Pieejamība pēc pieprasījuma</h3>
          <p>Ja prece nav noliktavā, rakstiet mums un precizēsim piegādes iespējas.</p>
        </div>
      <% } %>

      <div class="product-support-card">
        <span class="eyebrow">Jautājumi?</span>
        <p>Ja nepieciešams pielāgots zīmoga teksts, makets vai cita modifikācija, rakstiet mums pirms pasūtījuma.</p>
        <a href="/kontakti" class="btn btn-outline">Atvērt kontaktus</a>
      </div>
    </div>
  </div>
</section>

<section class="section section-muted">
  <div class="container">
    <div class="section-heading section-heading-left">
      <span class="eyebrow">Produkta apraksts</span>
      <h2>Apraksts un nospieduma paraugs</h2>
    </div>

    <div class="product-description-card">
      <% if (it.product.description) { %>
        <%~ it.product.description %>
      <% } else { %>
        <p>Šim produktam apraksts vēl tiks pievienots.</p>
      <% } %>

      <% if (it.product.imprintImage && !(it.product.description || '').includes(it.product.imprintImage)) { %>
        <div class="product-imprint-preview">
          <h3>Nospieduma paraugs</h3>
          <img src="<%= it.product.imprintImage %>" alt="Nospieduma paraugs <%= it.product.name %>" loading="lazy">
        </div>
      <% } %>
    </div>
  </div>
</section>

<% if (it.related.length > 0) { %>
<section class="section section-muted">
  <div class="container">
    <div class="section-heading section-heading-left">
      <span class="eyebrow">Saistītās preces</span>
      <h2>Līdzīgi produkti no tās pašas kategorijas</h2>
    </div>

    <div class="products-grid">
      <% for (const p of it.related) { %>
        <article class="product-card">
          <a href="/veikals/<%= p.slug %>">
            <div class="product-img">
              <% if (p.image) { %>
                <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
              <% } else { %>
                <div class="product-img-placeholder">LD</div>
              <% } %>
            </div>
            <div class="product-info">
              <div class="product-name"><%= p.name %></div>
              <div class="product-price"><%= Number(p.price).toFixed(2) %> € <span class="product-price-vat">+ PVN</span></div>
            </div>
          </a>
          <div class="product-actions">
            <form action="/grozs/add" method="POST">
              <input type="hidden" name="productId" value="<%= p.id %>">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="btn btn-dark btn-full btn-sm">Pievienot grozam</button>
            </form>
          </div>
        </article>
      <% } %>
    </div>
  </div>
</section>
<% } %>
