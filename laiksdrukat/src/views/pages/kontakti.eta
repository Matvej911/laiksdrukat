<% layout('../partials/layout') %>
<% const formData = it.formData || {} %>

<section class="page-hero page-hero-compact contact-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Sākums</a>
      <span class="breadcrumb-sep">/</span>
      <span>Kontakti</span>
    </div>

    <div class="page-hero-copy">
      <span class="eyebrow">Kontakti</span>
      <h1>Sazinieties ar Laiks Drukāt</h1>
      <p>Vienmēr gatavi palīdzēt ar jūsu jautājumiem un pasūtījumiem. Rakstiet mums, pievienojiet failu un ērti atrodiet mūsu atrašanās vietu Jelgavā.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="container contact-top-grid">
    <div class="contact-panel">
      <span class="eyebrow">Tiešā saziņa</span>
      <h2>Kontaktu informācija</h2>

      <div class="contact-stack">
        <div class="contact-row">
          <span class="contact-label">Adrese</span>
          <a href="<%= it.site.contact.mapUrl %>" target="_blank" rel="noreferrer"><%= it.site.contact.address %></a>
        </div>
        <% for (const phone of it.site.contact.phones) { %>
          <div class="contact-row">
            <span class="contact-label">Tālrunis</span>
            <a href="<%= phone.href %>"><%= phone.label %></a>
          </div>
        <% } %>
        <div class="contact-row">
          <span class="contact-label">E-pasts</span>
          <a href="<%= it.site.contact.emailHref %>"><%= it.site.contact.email %></a>
        </div>
        <div class="contact-row">
          <span class="contact-label">Facebook</span>
          <a href="<%= it.site.contact.facebook.url %>" target="_blank" rel="noreferrer"><%= it.site.contact.facebook.label %></a>
        </div>
      </div>

      <div class="contact-actions">
        <a href="<%= it.site.contact.emailHref %>" class="btn btn-primary">Rakstīt e-pastu</a>
        <a href="<%= it.site.contact.mapUrl %>" class="btn btn-outline" target="_blank" rel="noreferrer">Atvērt kartē</a>
      </div>
    </div>

    <div class="contact-panel contact-panel-accent">
      <span class="eyebrow">Ātrākai atbildei</span>
      <h2>Kas palīdz sagatavot piedāvājumu</h2>
      <ul class="info-list">
        <li>Pakalpojuma veids vai interesējošā prece.</li>
        <li>Izmērs, tirāža vai cits aptuvenais darba apjoms.</li>
        <li>Termiņš un svarīgākās prasības materiālam vai dizainam.</li>
        <li>Faili, logotipi vai vizuālie piemēri, ja tie jau ir sagatavoti.</li>
      </ul>

      <div class="note-card">
        <h3>Juridiskā informācija</h3>
        <p><%= it.site.company.legalName %> · Reģ. Nr. <%= it.site.company.registrationNumber %></p>
      </div>
    </div>
  </div>
</section>

<section class="section section-muted">
  <div class="container contact-page-grid">
    <div class="contact-map-card">
      <div class="contact-map-frame">
        <iframe
          src="<%= it.site.contact.mapEmbedUrl %>"
          title="Laiks Drukāt atrašanās vieta kartē"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

      <div class="contact-map-actions">
        <div>
          <strong><%= it.site.contact.shortAddress %></strong>
          <p>Viegli atrodama lokācija klientu apmeklējumam Jelgavā.</p>
        </div>
        <a href="<%= it.site.contact.mapUrl %>" class="btn btn-outline" target="_blank" rel="noreferrer">Atvērt Google Maps</a>
      </div>
    </div>

    <div class="contact-form-card">
      <span class="eyebrow">Ziņa mums</span>
      <h2>Nosūtīt pieprasījumu</h2>
      <p>Atbildēsim, tiklīdz būsim apskatījuši jūsu ziņu un pievienotos failus.</p>

      <% if (it.success) { %>
        <div class="contact-success">Ziņa veiksmīgi nosūtīta. Sazināsimies ar jums pēc iespējas ātrāk.</div>
      <% } %>

      <% if (it.error) { %>
        <div class="form-error"><%= it.error %></div>
      <% } %>

      <form action="/kontakti" method="POST" enctype="multipart/form-data" class="contact-form">
        <div class="form-group">
          <label class="form-label">Vārds <span class="required">*</span></label>
          <input type="text" name="name" class="form-input" required value="<%= formData.name || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">E-pasts <span class="required">*</span></label>
          <input type="email" name="email" class="form-input" required value="<%= formData.email || '' %>">
        </div>

        <div class="form-group">
          <label class="form-label">Tālrunis</label>
          <input type="tel" name="phone" class="form-input" value="<%= formData.phone || '' %>">
        </div>

        <div class="form-group">
          <div class="form-label-row">
            <label class="form-label">Jūsu ziņa <span class="required">*</span></label>
            <span class="character-count"><span data-message-count><%= (formData.message || '').length %></span> / 180</span>
          </div>
          <textarea
            name="message"
            class="form-input form-textarea contact-message-input"
            maxlength="180"
            required
            data-message-input
          ><%= formData.message || '' %></textarea>
        </div>

        <div class="form-group">
          <label class="form-label">Faila pielikums</label>
          <label class="upload-dropzone">
            <input type="file" name="attachment" class="upload-dropzone-input" data-file-input accept=".pdf,.jpg,.jpeg,.png,.svg,.ai,.eps,.doc,.docx,.xls,.xlsx">
            <span class="upload-dropzone-copy">
              <strong>Pievienot failu</strong>
              <small data-file-label>Izvēlieties failu vai ievelciet to šeit</small>
            </span>
          </label>
        </div>

        <button type="submit" class="btn btn-primary">Nosūtīt</button>
      </form>
    </div>
  </div>
</section>
