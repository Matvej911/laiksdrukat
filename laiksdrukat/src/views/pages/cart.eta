<%~ includeFile('partials/layout', { ...it, body: `

<section class="section-sm">
  <div class="container">
    <h1 style="font-size:32px;font-weight:800;margin-bottom:32px;">Iepirkumu grozs</h1>

    <% if (it.cart.length === 0) { %>
      <div style="text-align:center;padding:80px 0;">
        <div style="font-size:64px;margin-bottom:20px;">🛒</div>
        <h2 style="font-size:20px;font-weight:600;margin-bottom:12px;">Grozs ir tukšs</h2>
        <p style="color:var(--gray-600);margin-bottom:28px;">Pievienojiet preces no mūsu veikala</p>
        <a href="/veikals" class="btn btn-primary">Uz veikalu</a>
      </div>
    <% } else { %>
      <div style="display:grid;grid-template-columns:1fr 340px;gap:40px;align-items:start;">
        <div>
          <table class="cart-table">
            <thead>
              <tr>
                <th>Prece</th>
                <th>Cena</th>
                <th>Daudzums</th>
                <th>Kopā</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% for (const item of it.cart) { %>
              <tr>
                <td>
                  <div style="display:flex;align-items:center;gap:12px;">
                    <div style="width:60px;height:60px;background:var(--gray-100);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0;">
                      🔖
                    </div>
                    <span style="font-weight:500;"><%= item.name %></span>
                  </div>
                </td>
                <td><%= item.price.toFixed(2) %> €</td>
                <td>
                  <form action="/grozs/update" method="POST" style="display:flex;align-items:center;gap:8px;">
                    <input type="hidden" name="productId" value="<%= item.productId %>">
                    <input type="number" name="quantity" value="<%= item.quantity %>" min="1" class="qty-input">
                    <button type="submit" class="btn btn-sm btn-outline" style="padding:6px 10px;">↻</button>
                  </form>
                </td>
                <td style="font-weight:600;"><%= (item.price * item.quantity).toFixed(2) %> €</td>
                <td>
                  <form action="/grozs/remove" method="POST">
                    <input type="hidden" name="productId" value="<%= item.productId %>">
                    <button type="submit" style="background:none;border:none;cursor:pointer;color:var(--gray-400);font-size:18px;" title="Dzēst">×</button>
                  </form>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
          <div style="margin-top:16px;">
            <a href="/veikals" style="font-size:14px;color:var(--gray-600);">← Turpināt iepirkties</a>
          </div>
        </div>

        <div class="cart-summary">
          <h3 style="font-size:18px;font-weight:700;margin-bottom:20px;">Pasūtījuma kopsavilkums</h3>
          <div style="display:flex;justify-content:space-between;margin-bottom:8px;font-size:14px;">
            <span style="color:var(--gray-600);">Preces</span>
            <span><%= it.total.toFixed(2) %> €</span>
          </div>
          <div style="display:flex;justify-content:space-between;margin-bottom:8px;font-size:14px;">
            <span style="color:var(--gray-600);">PVN (21%)</span>
            <span><%= (it.total * 0.21).toFixed(2) %> €</span>
          </div>
          <div style="border-top:1px solid var(--gray-200);margin:16px 0;"></div>
          <div style="display:flex;justify-content:space-between;margin-bottom:24px;">
            <span style="font-weight:700;">Kopā ar PVN</span>
            <span class="cart-total"><%= (it.total * 1.21).toFixed(2) %> €</span>
          </div>
          <a href="/checkout" class="btn btn-primary btn-full">Noformēt pasūtījumu →</a>
          <p style="font-size:12px;color:var(--gray-400);margin-top:12px;text-align:center;">
            Piegādes izmaksas tiks aprēķinātas pie pasūtījuma
          </p>
        </div>
      </div>
    <% } %>
  </div>
</section>

`}) %>
